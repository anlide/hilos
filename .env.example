# Hilos Configuration Example
# Copy this file to .env and adjust values for your environment

# ===================================
# Application Environment (APP_ENV)
# ===================================
# Canonical values (AppEnv): prod | staging | dev | local | test
# Aliases: production->prod, development->dev, live->prod, etc.
# When PROD or STAGING: database seeds are disabled
# APP_ENV=dev

# ===================================
# Daemon Network Configuration
# ===================================

# IP address of the hilos daemon container
# Used by CLI and Monitor to connect to the daemon
# Default: 172.25.0.10 (fixed IP in Docker network)
HILOS_DAEMON_HOST=172.25.0.10

# ===================================
# HTTP Status Endpoint
# ===================================

# Host the daemon HTTP server binds to
# 0.0.0.0 = listen on all interfaces
HTTP_STATUS_HOST=0.0.0.0

# Port for HTTP status endpoint
# Daemon exposes /status endpoint on this port
HTTP_STATUS_PORT=8090

# ===================================
# Worker Communication
# ===================================

# Host the worker communication server binds to
WORKER_COMM_HOST=0.0.0.0

# Port for worker communication
WORKER_COMM_PORT=8091

# ===================================
# Websocket Communication
# ===================================

# Host the websocket server binds to
WEBSOCKET_HOST=0.0.0.0

# Port for websocket
WEBSOCKET_PORT=8092

# ===================================
# Database Configuration
# ===================================

# MySQL/MariaDB connection settings
DB_HOST=hilos-mysql
DB_PORT=3306
DB_NAME=hilos_db
DB_USER=hilos_user
DB_PASSWORD=hilos_user_password
DB_ROOT_PASSWORD=hilos_password_2024

# ===================================
# Logging
# ===================================

# Log file paths (inside container)
DAEMON_LOG_FILE=/var/log/hilos/daemon.log
DAEMON_ERROR_LOG_FILE=/var/log/hilos/daemon-error.log

# ===================================
# Docker Network
# ===================================

# Docker network subnet for hilos services
DOCKER_NETWORK_SUBNET=172.25.0.0/16

# Fixed IP for daemon container
DOCKER_DAEMON_IP=172.25.0.10

# ===================================
# Local LLM (Ollama)
# ===================================
# Base URL for local Ollama. Framework runs Ollama as separate compose project (port 11434 exposed to host).
# Demo containers connect via host: e.g. http://host.docker.internal:11434 (Windows/Mac)
# or external AI farm: http://ai-farm:11434
# OLLAMA_HOST_PORT=11434
