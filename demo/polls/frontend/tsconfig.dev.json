      ],
      "@hilos/angular/admin/i18n": [
        "../../../framework/frontend/angular/src/admin/i18n/index.ts"
      ],
      "@hilos/angular/admin/legal": [
        "../../../framework/frontend/angular/src/admin/legal/index.ts"
      ],
      "@hilos/angular/admin/logs": [
        "../../../framework/frontend/angular/src/admin/logs/index.ts"
      ],
      "@hilos/angular/admin/maintenance": [
        "../../../framework/frontend/angular/src/admin/maintenance/index.ts"
      ],
      "@hilos/angular/admin/moderation": [
        "../../../framework/frontend/angular/src/admin/moderation/index.ts"
      ],
      "@hilos/angular/admin/mcp-skills": [
        "../../../framework/frontend/angular/src/admin/mcpSkills/index.ts"
      ],
      "@hilos/angular/admin/roles": [
        "../../../framework/frontend/angular/src/admin/roles/index.ts"
      ],
