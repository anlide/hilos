      ],
      "@hilos/angular/admin/users": [
        "../../../framework/frontend/angular/src/admin/users/index.ts"
      ],
      "@hilos/core": ["../../../framework/frontend/core/src/index.ts"],
      "@hilos/core/base": [
        "../../../framework/frontend/core/src/base/index.ts"
      ],
      "@hilos/core/admin/i18n": [
        "../../../framework/frontend/core/src/admin/i18n/index.ts"
      ],
      "@hilos/core/admin/users": [
