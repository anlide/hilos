      ],
      "@hilos/core/admin/maintenance": [
        "../../../framework/frontend/core/src/admin/maintenance/index.ts"
      ],
      "@hilos/core/admin/moderation": [
        "../../../framework/frontend/core/src/admin/moderation/index.ts"
      ],
      "@hilos/core/admin/communications": [
        "../../../framework/frontend/core/src/admin/communications/index.ts"
      ],
      "@hilos/core/admin/security": [
        "../../../framework/frontend/core/src/admin/security/index.ts"
      ],
      "@hilos/core/admin/logs": [
        "../../../framework/frontend/core/src/admin/logs/index.ts"
      ],
      "@hilos/core/admin/daemon": [
        "../../../framework/frontend/core/src/admin/daemon/index.ts"
      ],
      "@hilos/core/admin/change-log": [
