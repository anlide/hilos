# Test environment configuration
# Tracked: every checkout runs the tests with these values. To change one for a local
# run, set it in the process environment, which outranks this file
# Composer test commands run inside the test CLI container.

APP_ENV=test
HILOS_PROJECT_TIME_ZONE=Europe/Warsaw
DB_HOST=solar-system-model-mysql-test
DB_PORT=3306
DB_DATABASE=hilos-demo-solar-system-model-test
DB_USERNAME=hilos
DB_PASSWORD=hilos_pass

# Anti-abuse throttling is off in tests: the suites sign in and request codes far
# faster than a human ever would, so the ladder would refuse them for behaving like
# the tests they are (HIL-420).
HILOS_AUTH_THROTTLE_ENABLED=false
