#!/usr/bin/env bash
#
# cluster - host-side controller for the multi-node daemon-cluster e2e harness
# (HIL-185). Preview-style: a thin orchestrator over `docker compose` plus the three
# fault switches the scenarios need — `docker kill -9` (node-down / failover),
# `docker network disconnect` (partition / split-brain), and a SIGKILL of the daemon
# inside a live container (crash recovery). Assertions live in the Python scenario
# driver (cluster_e2e.py), which reads each node's `cluster:test:inspect` reply and
# compares against the expected invariants.
#
# Usage:
#   cluster up                 build + start mysql, the 5 nodes, and the cli container
#   cluster down [--volumes]   stop and remove the stack (add --volumes to wipe the DB)
#   cluster status             docker ps for the stack + a one-line inspect per node
#   cluster inspect <node>     print a node's cluster:test:inspect JSON (m1..m3,s1,s2)
#   cluster kill <node>        docker kill -9 a node container (simulate node-down)
#   cluster start <node>       (re)start a node container, reusing it as it is
#   cluster recreate <node>    replace a node with a pristine container
#   cluster crash-daemon <n>   SIGKILL the daemon inside a live node container
#   cluster container-id <n>   print a node's docker container id
#   cluster partition <node>   disconnect a node from the cluster network
#   cluster heal <node>        reconnect a node to the cluster network (static IP)
#   cluster logs <node>        follow a node's container logs
#   cluster scenarios          run the full 9-scenario matrix (drives cluster_e2e.py)

set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
demo="$(cd "$here/.." && pwd)"
compose_file="$here/docker-compose.cluster.yml"
net="hilos-cluster-net"

NODES=(m1 m2 m3 s1 s2)
declare -A NODE_IP=(
  [m1]=10.185.0.11 [m2]=10.185.0.12 [m3]=10.185.0.13
  [s1]=10.185.0.14 [s2]=10.185.0.15
)

dc() { docker compose -f "$compose_file" "$@"; }
die() { echo "cluster: $*" >&2; exit 1; }

valid_node() {
  local n="$1"
  [[ -n "${NODE_IP[$n]:-}" ]] || die "unknown node '$n' (expected one of: ${NODES[*]})"
}

ensure_env() {
  [ -f "$demo/.env" ] || cp "$demo/.env.example" "$demo/.env"
  [ -f "$demo/tests/.env" ] || cp "$demo/tests/.env.example" "$demo/tests/.env"
  mkdir -p "$demo/data/logs"
}

cmd_up() {
  ensure_env
  echo "cluster: building images..."
  dc build
  echo "cluster: starting mysql + 5 nodes..."
  dc up -d cluster-mysql cluster-m1 cluster-m2 cluster-m3 cluster-s1 cluster-s2
  echo "cluster: starting cli container..."
  dc --profile cli up -d cluster-cli
  echo "cluster: up. Give the mesh a few seconds to elect a leader, then:"
  echo "  $0 status      # see roster + leader per node"
  echo "  $0 scenarios   # run the assertion matrix"
}

cmd_down() {
  local extra=()
  [[ "${1:-}" == "--volumes" ]] && extra=(-v)
  dc --profile "*" down "${extra[@]}"
}

cmd_inspect() {
  local node="${1:-}"; valid_node "$node"
  docker exec -e HILOS_DAEMON_HOST="${NODE_IP[$node]}" cluster-cli \
    php backend/Bootstrap/cli.php cluster:test:inspect
}

# Inspect a node from INSIDE its own container over localhost. Needed when the node
# is network-partitioned (unreachable from the shared cli container and from MySQL):
# cluster:test:inspect is DB-free, so it still answers over the local command socket.
cmd_inspect_local() {
  local node="${1:-}"; valid_node "$node"
  docker exec -e APP_ENV=test -e HILOS_DAEMON_HOST=127.0.0.1 "cluster-$node" \
    php backend/Bootstrap/cli.php cluster:test:inspect
}

cmd_status() {
  echo "== containers =="
  docker ps --filter "label=com.docker.compose.project=hilos-cluster" \
    --format 'table {{.Names}}\t{{.Status}}'
  echo
  echo "== per-node cluster view =="
  local status_py
  status_py='
import json, sys
node = sys.argv[1]
raw = sys.stdin.read()
i = raw.find("{")
if i < 0:
    print("  %-4s (unreachable)" % node); sys.exit(0)
try:
    d = json.loads(raw[i:])
except Exception:
    print("  %-4s (bad reply)" % node); sys.exit(0)
if not d.get("enabled"):
    print("  %-4s cluster disabled" % node); sys.exit(0)
pl = ",".join("%s@%s:%s" % (p["agentId"], p["nodeId"], p["state"]) for p in d.get("placements", [])) or "-"
print("  %-4s phase=%-26s leader=%-4s term=%s quorum=%s placements=%s" % (
    node, d.get("lifecycleState"), str(d.get("leaderId")), d.get("term"), d.get("hasQuorum"), pl))
'
  for n in "${NODES[@]}"; do
    cmd_inspect "$n" 2>/dev/null | python3 -c "$status_py" "$n" || printf '  %-4s (unreachable)\n' "$n"
  done
}

# Emits the per-node cluster view as JSON for the preview control panel:
# {"nodes":[{node,reachable,enabled,role,phase,leader,term,quorum,placements}]}.
# Empty {"nodes":[]} when the stand is down (one cheap check, no per-node execs).
# A single Python process does the whole job (one json.dumps) so the output is
# always valid JSON, not a fragile shell string-join.
cmd_status_json() {
  if ! docker inspect -f '{{.State.Running}}' cluster-cli >/dev/null 2>&1; then
    printf '{"nodes":[]}\n'
    return
  fi

  local map="" n
  for n in "${NODES[@]}"; do map+="$n=${NODE_IP[$n]} "; done

  CLUSTER_NODE_MAP="$map" python3 <<'PY'
import json, os, subprocess

nodes = [kv.split("=", 1) for kv in os.environ["CLUSTER_NODE_MAP"].split() if kv]
out = []
for node, ip in nodes:
    try:
        r = subprocess.run(
            ["docker", "exec", "-e", "HILOS_DAEMON_HOST=" + ip, "cluster-cli",
             "php", "backend/Bootstrap/cli.php", "cluster:test:inspect"],
            capture_output=True, text=True, timeout=15)
        i = r.stdout.find("{")
        d = json.loads(r.stdout[i:]) if i >= 0 else None
    except Exception:
        d = None
    if d is None:
        out.append({"node": node, "reachable": False})
        continue
    if not d.get("enabled"):
        out.append({"node": node, "reachable": True, "enabled": False})
        continue
    out.append({
        "node": node, "reachable": True, "enabled": True,
        "role": next((x["role"] for x in d.get("nodes", []) if x["nodeId"] == node), None),
        "phase": d.get("lifecycleState"), "leader": d.get("leaderId"),
        "term": d.get("term"), "quorum": d.get("hasQuorum"),
        "placements": ["%s@%s:%s" % (p["agentId"], p["nodeId"], p["state"])
                       for p in d.get("placements", [])],
    })
print(json.dumps({"nodes": out}))
PY
}

cmd_restart() { cmd_down; cmd_up; }

cmd_kill() { local n="${1:-}"; valid_node "$n"; docker kill "cluster-$n" >/dev/null && echo "cluster: killed cluster-$n"; }
# Restart the EXISTING container instead of recreating it: a node has to come back on
# its own hardware, leftovers and all. A daemon that crashed internally orphans workers
# that keep holding its ports, and the watchdog now sweeps them before the next daemon
# binds (Hilos\Core\Daemon\OrphanReaper) — so `--force-recreate` here would hide exactly
# what scenario 9 guards.
cmd_start() { local n="${1:-}"; valid_node "$n"; dc up -d "cluster-$n" >/dev/null && echo "cluster: started cluster-$n"; }
# Replace a node with a pristine container. For the one case that genuinely needs a
# fresh socket stack — healing a partition, where reconnecting the interface would
# leave half-open sockets on both sides — and never for an ordinary restart.
cmd_recreate() { local n="${1:-}"; valid_node "$n"; dc up -d --force-recreate "cluster-$n" >/dev/null && echo "cluster: recreated cluster-$n"; }
cmd_container_id() { local n="${1:-}"; valid_node "$n"; docker inspect -f '{{.Id}}' "cluster-$n"; }

# Kill the daemon INSIDE a running container, leaving the watchdog (PID 1) and the
# daemon's workers alive: the workers are re-parented onto the watchdog and keep the
# daemon's listening sockets, which is the state a real internal crash produces.
# The lookup runs in PHP because the image carries no procps (no pgrep/pkill) and PHP
# is the one interpreter guaranteed to be there; `display_errors=stderr` keeps a warning
# about a process that exited mid-scan out of the pid on stdout.
# It skips its own pid first, exactly as OrphanReaper::findChildren() does: this script
# is passed with `-r`, so its source — needle included — is its own command line, and
# /proc listed lexicographically puts a two-digit pid ahead of the daemon's one-digit
# one. Without the skip the helper SIGKILLs itself and never reaches the daemon.
crash_daemon_php='
$self = getmypid();
$pid = null;
foreach (glob("/proc/[0-9]*/cmdline") ?: [] as $file) {
    $candidate = (int)basename(dirname($file));
    if ($candidate === $self) {
        continue;
    }
    $cmdline = file_get_contents($file);
    if ($cmdline === false || !str_contains($cmdline, "Bootstrap/daemon.php")) {
        continue;
    }
    $pid = $candidate;
    break;
}
if ($pid === null) {
    fwrite(STDERR, "no daemon process found" . PHP_EOL);
    exit(1);
}
posix_kill($pid, SIGKILL);
echo $pid, PHP_EOL;
'
cmd_crash_daemon() {
  local n="${1:-}"; valid_node "$n"
  local pid
  pid="$(docker exec "cluster-$n" php -d display_errors=stderr -r "$crash_daemon_php")" \
    || die "no daemon process to kill inside cluster-$n"
  echo "cluster: SIGKILLed daemon pid $pid inside cluster-$n"
}

cmd_partition() { local n="${1:-}"; valid_node "$n"; docker network disconnect "$net" "cluster-$n" && echo "cluster: partitioned cluster-$n"; }
cmd_heal() { local n="${1:-}"; valid_node "$n"; docker network connect --ip "${NODE_IP[$n]}" "$net" "cluster-$n" && echo "cluster: reconnected cluster-$n"; }
cmd_logs() { local n="${1:-}"; valid_node "$n"; dc logs -f "cluster-$n"; }

cmd_scenarios() {
  # Ensure the stack is up (idempotent) before the driver perturbs it.
  if ! docker inspect -f '{{.State.Running}}' cluster-cli >/dev/null 2>&1; then
    cmd_up
  fi
  python3 "$here/cluster_e2e.py"
}

case "${1:-}" in
  up)        shift; cmd_up "$@" ;;
  down)      shift; cmd_down "$@" ;;
  restart)   shift; cmd_restart ;;
  status)    shift; cmd_status ;;
  status-json) shift; cmd_status_json ;;
  inspect)   shift; cmd_inspect "$@" ;;
  inspect-local) shift; cmd_inspect_local "$@" ;;
  kill)      shift; cmd_kill "$@" ;;
  start)     shift; cmd_start "$@" ;;
  recreate)  shift; cmd_recreate "$@" ;;
  crash-daemon) shift; cmd_crash_daemon "$@" ;;
  container-id) shift; cmd_container_id "$@" ;;
  partition) shift; cmd_partition "$@" ;;
  heal)      shift; cmd_heal "$@" ;;
  logs)      shift; cmd_logs "$@" ;;
  scenarios) shift; cmd_scenarios ;;
  *)         die "usage: cluster {up|down|restart|status|inspect|kill|start|recreate|crash-daemon|container-id|partition|heal|logs|scenarios} [args]" ;;
esac
