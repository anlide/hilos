# Tasks Demo Project Configuration
# Nothing copies this file to .env for you: run `composer run setup-env` when you want
# one. A value read from .env is only a DEFAULT - whatever the container's environment
# sets outranks it. Everything the compose stack already gives is therefore left
# commented out, its value kept visible after the `#`: uncommenting it here would
# change nothing, because the stack's value wins anyway.

# Network Configuration. The daemon binds fixed in-container ports — the same
# for every demo, because the nginx template proxies /ws to :8092. The host
# side publishes them at shifted ports (see docker-compose.local.yml: defaults
# 8098 status / 8099 worker comm / 8100 websocket, plus nginx on 444).
#
# Those host-side publishes CANNOT be changed from this file. This file is the
# container `env_file`; the publishes are compose interpolation
# (${HTTP_STATUS_HOST_PORT}, ${NGINX_HTTPS_PORT}, ${FRONTEND_DEV_PORT}, …),
# which compose resolves from the shell environment or from docker/.env before
# any container exists. Override them per run, or put them in docker/.env (see
# docker/.env.example); a value written here is silently ignored.
# HTTP_STATUS_HOST=0.0.0.0
# HTTP_STATUS_PORT=8090
# WORKER_COMM_HOST=0.0.0.0
# WORKER_COMM_PORT=8091
# WEBSOCKET_HOST=0.0.0.0
# WEBSOCKET_PORT=8092

# Trusted proxies (HIL-680). The networks whose X-Real-IP header is believed to
# name the visitor, comma-separated, each in CIDR notation and a single address
# written as /32 or /128. Empty is the default and trusts nobody: the address a
# connection is counted and logged by is then the address of its TCP peer, which
# is correct for a daemon facing the network directly - and the only safe answer
# for one behind a proxy that was never named here, since a header anyone may
# send cannot be the identity anti-abuse counts by. Put the network of your own
# nginx here; a chain in front of it (a CDN) is unrolled by nginx itself
# (set_real_ip_from / real_ip_header), not by the framework.
# 0.0.0.0/0 and ::/0 are not accepted: they trust every peer, which lets any
# client name its own address - the very thing this variable exists to stop.
# HILOS_TRUSTED_PROXIES=

# Build timestamp carried in the WebSocket handshake welcome frame. The frontend
# compares it on every (re)connect and forces a page refresh on mismatch. The
# frontend build writes dist/build-timestamp.txt and the daemon picks it up at
# startup, so test/production get a real value automatically. Set this only to
# override; defaults to 'dev' (dev server, no build).
# HILOS_BUILD_TIMESTAMP=dev

# OAuth login (HIL-281, HIL-419). Each provider is a client id/secret pair; leaving
# a pair empty selects the offline stub for THAT provider, so dev/e2e log in with no
# real round-trip, and a half-configured app still starts. Fill a pair to enable the
# real flow (register the callback URL with that provider). The callback address is
# one for the whole app - a single /auth/callback route, whoever is coming back.
# OAUTH_STATE_SECRET signs the stateless, session-bound `state` token - override
# the dev default in any real deployment.
# OAUTH_STATE_SECRET=change-me
# OAUTH_GITHUB_CLIENT_ID=
# OAUTH_GITHUB_CLIENT_SECRET=
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=
# OAUTH_REDIRECT_URI=/auth/callback

# Magic-link sign-in (HIL-417). The screen a mailed sign-in link comes back to, with
# the address and its token appended as query params. It travels in a letter, so it
# has to be absolute - a path would resolve against the mail client, not the app.
# The framework default names port 5173, which belongs to the chat demo's dev
# server; this demo publishes its own on 5174, so the local stack overrides the key
# and the value below is that override. Set it to the deployed origin in production.
# HILOS_MAGIC_LINK_URL=http://localhost:5174/auth/magic

# Logging
DAEMON_LOG_FILE=/var/log/hilos/daemon.log
DAEMON_ERROR_LOG_FILE=/var/log/hilos/daemon-error.log

# Container watchdog alert (HIL-617). The watchdog's OWN mail, and nothing to do
# with the application's MAIL_* settings: it has to be able to report itself on a
# box where the application mail is not configured at all, so it never borrows
# those values and never falls back to the file transport. It writes on exactly two occasions - the daemon failed to
# start DAEMON_FAILED_START_THRESHOLD times in a row, and the watchdog is exiting
# after a failure of its own. Leaving WATCHDOG_ALERT_SMTP_HOST, _FROM_ADDRESS or
# _TO_ADDRESS empty means "not configured": the watchdog names the missing
# variables in the log and sends nothing. One recipient only - fanning out to
# several is the relay's job.
# Prefer an IP address for the host: the name lookup in front of the connect is
# synchronous and outside WATCHDOG_ALERT_TIMEOUT_MS, so a box whose DNS is gone can
# stall the dying watchdog on it.
# WATCHDOG_ALERT_SMTP_HOST=
# WATCHDOG_ALERT_SMTP_PORT=587
# WATCHDOG_ALERT_SMTP_SECURITY=starttls
# WATCHDOG_ALERT_SMTP_USERNAME=
# WATCHDOG_ALERT_SMTP_PASSWORD=
# WATCHDOG_ALERT_FROM_ADDRESS=
# WATCHDOG_ALERT_TO_ADDRESS=
# WATCHDOG_ALERT_TIMEOUT_MS=5000

# ===================================
# Application Environment
# ===================================
# Canonical values (AppEnv): prod | staging | dev | local | test.
# Required: a node that names no APP_ENV refuses to start rather than call itself
# dev, which is the one answer that opens every test-only command on a port that
# authenticates nobody.
# APP_ENV=dev
