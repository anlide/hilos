{
  "name": "demo-tasks",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Tasks demo — an end project that consumes the Hilos frontend SDK (@hilos/react); doubles as the React conformance demo.",
  "scripts": {
    "predev": "node ../../../framework/frontend/scripts/generate-license-inventory.mjs",
    "dev": "vite",
    "prebuild": "node ../../../framework/frontend/scripts/prebuild-sdk.mjs react && node ../../../framework/frontend/scripts/generate-license-inventory.mjs",
    "build": "vite build && vite build --ssr scripts/prerenderEntry.tsx --outDir dist-prerender && node dist-prerender/prerenderEntry.js && node node_modules/@hilos/core/bin/theme-head.mjs dist",
    "preview": "vite preview",
    "precheck": "node ../../../framework/frontend/scripts/generate-license-inventory.mjs",
    "check": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@hilos/core": "file:../../../framework/frontend/core",
    "@hilos/react": "file:../../../framework/frontend/react",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "sass-embedded": "^1.107.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.3.7"
  }
}
