# Local host-port overrides for the online-testing demo — copy to docker/.env.
#
# Compose reads a `.env` from THIS directory (docker/) before any container
# exists and uses it to interpolate the ${VAR:-default} host-port publishes in
# docker-compose.local.yml. This is NOT the container env_file — that is the
# demo's ../.env, which only reaches container environments. A host-port value
# set in ../.env is silently ignored; set it here to actually move the port.
#
# docker/.env is gitignored (host-specific). Leave it absent, or leave a knob
# below commented, and compose keeps the default shown — no setup step is needed
# on a fresh clone. Uncomment and change a knob to republish that service on a
# different host port (e.g. to dodge a port already taken on this host).

# Bind address for every host publish in this stack. The default 127.0.0.1
# keeps a fresh clone closed — MySQL, nginx and the dev server are
# reachable only from this machine. Set it ONLY on a host that must expose the
# stack to a LAN or tailnet (e.g. 0.0.0.0, or a specific interface address).
# A bogus value fails at `up` with docker's own "bind: cannot assign requested
# address".
# HILOS_BIND_HOST=127.0.0.1

# Daemon status / worker-comm / websocket, published to the host (shifted per
# demo so stacks coexist; this demo owns the 8150-8169 block):
# HTTP_STATUS_HOST_PORT=8150
# WORKER_COMM_HOST_PORT=8151
# WEBSOCKET_HOST_PORT=8152

# MySQL, Mailpit, nginx HTTPS, and the Angular dev server:
# MYSQL_HOST_PORT=33071
# MAILPIT_HTTP_PORT=8160
# NGINX_HTTPS_PORT=8156
# FRONTEND_DEV_PORT=5178

# Production stack (docker-compose.prod.yml) only. The two passwords have no
# default there, and the stack refuses to start without them; they are this
# installation's secrets and never a value from this file.
# MYSQL_ROOT_PASSWORD=
# MYSQL_PASSWORD=
#
# The network of this installation. No default: the stack refuses to start without
# all four, so two installations on one host cannot share one by accident. One /24
# per installation on a host, from 10.240.0.0/16 (docs/new-project/README.md).
# DOCKER_NETWORK_SUBNET=10.240.1.0/24
# DOCKER_MYSQL_IP=10.240.1.10
# DOCKER_DAEMON_IP=10.240.1.11
# DOCKER_NGINX_IP=10.240.1.12
#
# Where the installation keeps its data (database, uploads, exports, Status,
# logs) - an absolute path outside the checkout, so the data outlives a release
# unpacked beside the old one. Unset, it is ../data inside the checkout.
# HILOS_DATA_ROOT=/srv/hilos/data
#
# Production nginx publishes on every address by default: it is the front door.
# Behind a proxy of its own on the same host, bind it to loopback, move the
# ports aside, and name the proxy's address so nginx believes its X-Real-IP
# (comma-separated CIDRs; empty trusts nobody).
# HILOS_BIND_HOST=127.0.0.1
# NGINX_HTTP_PORT=18080
# NGINX_HTTPS_PORT=18443
# NGINX_REAL_IP_FROM=10.240.1.1/32

# ===================================
# Application Environment
# ===================================
# Canonical values (AppEnv): prod | staging | dev | local | test.
# Required: a node that names no APP_ENV refuses to start rather than call itself
# dev, which is the one answer that opens every test-only command on a port that
# authenticates nobody.
APP_ENV=dev
