events {
    worker_connections 1024;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    map $http_upgrade $connection_upgrade {
        default upgrade;
        '' close;
    }

    upstream hilos_ws_m1 { server ${HILOS_CLUSTER_WS_M1}; }
    upstream hilos_ws_m2 { server ${HILOS_CLUSTER_WS_M2}; }
    upstream hilos_ws_m3 { server ${HILOS_CLUSTER_WS_M3}; }
    upstream hilos_ws_masters {
        server ${HILOS_CLUSTER_WS_M1};
        server ${HILOS_CLUSTER_WS_M2};
        server ${HILOS_CLUSTER_WS_M3};
    }

    upstream hilos_http_m1 { server ${HILOS_CLUSTER_HTTP_M1}; }
    upstream hilos_http_m2 { server ${HILOS_CLUSTER_HTTP_M2}; }
    upstream hilos_http_m3 { server ${HILOS_CLUSTER_HTTP_M3}; }
    upstream hilos_http_masters {
        server ${HILOS_CLUSTER_HTTP_M1};
        server ${HILOS_CLUSTER_HTTP_M2};
        server ${HILOS_CLUSTER_HTTP_M3};
    }

    map $cookie_hilos_stand_master $hilos_stand_ws {
        '' hilos_ws_masters;
        m1 hilos_ws_m1;
        m2 hilos_ws_m2;
        m3 hilos_ws_m3;
        default '';
    }

    map $cookie_hilos_stand_master $hilos_stand_http {
        '' hilos_http_masters;
        m1 hilos_http_m1;
        m2 hilos_http_m2;
        m3 hilos_http_m3;
        default '';
    }

    sendfile        on;
    keepalive_timeout  65;

    # HTTP server - redirect only to HTTPS
    server {
        listen 80;
        server_name localhost;
        return 301 https://$host$request_uri;
    }

    # HTTPS server
    server {
        listen 443 ssl;
        server_name localhost;
        root /usr/share/nginx/html;

        ssl_certificate     /etc/nginx/ssl/cert.pem;
        ssl_certificate_key /etc/nginx/ssl/key.pem;

        # Gzip compression
        gzip on;
        gzip_vary on;
        gzip_min_length 1024;
        gzip_types text/plain text/css text/xml text/javascript application/javascript application/json;

        # Trailing slash redirect to no-trailing-slash
        # Status namespace rejects every unlisted name, including trailing slashes.
        rewrite ^(?!/status-data(?:/|$))(.+)/$ $1 permanent;

        # Public Status files: exact names only; never ask the daemon.
        # Repeat security headers because add_header replaces inherited headers.
        location = /status-data/status.json {
            alias /status/status.json;
            default_type application/json;
            limit_except GET { deny all; }
            add_header Cache-Control "no-store" always;
            add_header X-Frame-Options "SAMEORIGIN" always;
            add_header X-Content-Type-Options "nosniff" always;
            add_header X-XSS-Protection "1; mode=block" always;
        }
        location = /status-data/heartbeat.json {
            alias /status/heartbeat.json;
            default_type application/json;
            limit_except GET { deny all; }
            add_header Cache-Control "no-store" always;
            add_header X-Frame-Options "SAMEORIGIN" always;
            add_header X-Content-Type-Options "nosniff" always;
            add_header X-XSS-Protection "1; mode=block" always;
        }
        location = /status-data {
            add_header Cache-Control "no-store" always;
            add_header X-Frame-Options "SAMEORIGIN" always;
            add_header X-Content-Type-Options "nosniff" always;
            add_header X-XSS-Protection "1; mode=block" always;
            return 404;
        }
        location ^~ /status-data/ {
            autoindex off;
            add_header Cache-Control "no-store" always;
            add_header X-Frame-Options "SAMEORIGIN" always;
            add_header X-Content-Type-Options "nosniff" always;
            add_header X-XSS-Protection "1; mode=block" always;
            return 404;
        }

        location = /status {
            try_files /index.csr.html =404;
        }

        # robots.txt and sitemap.xml - static
        location = /robots.txt { try_files $uri =404; }
        location = /sitemap.xml { try_files $uri =404; }

        # Static assets
        location /assets/ {
            try_files $uri =404;
            expires 1y;
            add_header Cache-Control "public, immutable";
        }
        location ~* \.(jpg|jpeg|png|gif|ico|css|js|svg|woff|woff2|ttf|eot)$ {
            try_files $uri =404;
            expires 1y;
            add_header Cache-Control "public, immutable";
        }

        # WebSocket upgrade proxy for Docker E2E and HTTPS deployments.
        # Session authorization stays in the agent; only nginx reads the archive body.
        location = /_hilos/data-export {
            if ($hilos_stand_http = '') { return 421; }
            proxy_pass http://$hilos_stand_http;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            add_header X-Hilos-Stand-Master $upstream_addr always;
        }
        location ^~ /__hilos_data_export/ {
            internal;
            alias /data_export/;
        }

        location /ws {
            if ($hilos_stand_ws = '') { return 421; }
            proxy_pass http://$hilos_stand_ws;
            add_header X-Hilos-Stand-Master $upstream_addr always;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_read_timeout 3600s;
        }

        location = / {
            try_files /index.csr.html =404;
        }

        # Hybrid SSG: a prerendered public page (Angular's static output mode emits
        # <route>/index.html) is served as static HTML; every other path cold-loads
        # the SPA shell (index.csr.html — the client-render fallback the static
        # build emits since / itself is not prerendered), which then takes over
        # client-side. The authed area is never prerendered
        # (docs/agents/frontend/build-and-docker.md).
        location / {
            try_files $uri $uri.html $uri/index.html /index.csr.html;
        }

        # Security headers
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-XSS-Protection "1; mode=block" always;
    }
}
