# Test environment configuration
# Tracked: every checkout runs the tests with these values. To change one for a local
# run, set it in the process environment, which outranks this file
# (e.g. DB_HOST=localhost and DB_PORT=33072 when running PHPUnit from host)

APP_ENV=test
DB_HOST=online-testing-mysql-test
DB_PORT=3306
DB_DATABASE=hilos-demo-online-testing-test
DB_USERNAME=hilos
DB_PASSWORD=hilos_pass
