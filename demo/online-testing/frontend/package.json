{
  "name": "demo-online-testing",
  "version": "0.0.0",
  "private": true,
  "description": "Online-testing demo — an end project that consumes the Hilos frontend SDK (@hilos/angular); the smallest complete shape on Angular.",
  "scripts": {
    "ng": "ng",
    "predev": "node ../../../framework/frontend/scripts/generate-license-inventory.mjs",
    "dev": "ng serve --host 0.0.0.0 --port 5173",
    "prebuild": "node ../../../framework/frontend/scripts/prebuild-sdk.mjs angular && node ../../../framework/frontend/scripts/generate-license-inventory.mjs",
    "build": "NG_BUILD_OPTIMIZE_CHUNKS=0 ng build && node node_modules/@hilos/core/bin/theme-head.mjs dist && node node_modules/@hilos/core/bin/initial-bundle-budget.mjs angular dist --project-sources src/app/pages/routes.ts src/app/app.ts",
    "test:table-geometry:build": "ng run demo-online-testing:build-table-geometry",
    "test:date-time-picker:build": "ng run demo-online-testing:build-date-time-picker",
    "postbuild": "node -e \"require('fs').writeFileSync('dist/build-timestamp.txt', new Date().toISOString())\"",
    "precheck": "node ../../../framework/frontend/scripts/generate-license-inventory.mjs",
    "check": "npm run check:types && npm run check:templates",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:types": "tsc --noEmit -p tsconfig.dev.json",
    "check:templates": "ng build --configuration development --stats-json && node ../../../framework/frontend/angular/test/dev-source.smoke.mjs dist"
  },
  "dependencies": {
    "@angular/common": "22.2.4",
    "@angular/compiler": "22.2.4",
    "@angular/core": "22.2.4",
    "@angular/platform-browser": "22.2.4",
    "@hilos/angular": "file:../../../framework/frontend/angular",
    "@hilos/core": "file:../../../framework/frontend/core",
    "@vue/reactivity": "^3.5.44",
    "bootstrap": "^5.3.3",
    "bootstrap-icons": "^1.13.2",
    "libphonenumber-js": "^1.13.15",
    "qrcode-generator": "^2.0.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.5",
    "@angular/cli": "22.2.5",
    "@angular/compiler-cli": "22.2.4",
    "@angular/platform-server": "22.2.4",
    "@angular/router": "22.2.4",
    "@angular/ssr": "22.2.5",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
