{
  "name": "demo-chat",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Chat demo — an end project that consumes the Hilos frontend SDK (@hilos/vue).",
  "scripts": {
    "predev": "node ../../../framework/frontend/scripts/generate-license-inventory.mjs",
    "dev": "vite",
    "prebuild": "node ../../../framework/frontend/scripts/prebuild-sdk.mjs vue && node ../../../framework/frontend/scripts/generate-license-inventory.mjs",
    "build": "vite build && vite build --ssr scripts/prerenderEntry.ts --outDir dist-prerender && node dist-prerender/prerenderEntry.js && node node_modules/@hilos/core/bin/theme-head.mjs dist",
    "test:table-geometry:build": "vue-tsc --noEmit -p tests/tableGeometry/tsconfig.json && vite build --config tests/tableGeometry/vite.config.ts && node node_modules/@hilos/core/bin/theme-head.mjs dist/__table_geometry",
    "preview": "vite preview",
    "precheck": "node ../../../framework/frontend/scripts/generate-license-inventory.mjs",
    "check": "vue-tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@hilos/core": "file:../../../framework/frontend/core",
    "@hilos/vue": "file:../../../framework/frontend/vue",
    "vue": "^3.5.35"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.9.2",
    "happy-dom": "^16.5.3",
    "prettier": "^3.8.4",
    "sass-embedded": "^1.83.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.8",
    "vue-tsc": "^3.3.4"
  }
}
