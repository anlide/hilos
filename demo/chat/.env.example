# WebSocket Test Demo Project Configuration
# Nothing copies this file to .env for you: run `composer run setup-env` when you want
# one. A value read from .env is only a DEFAULT - whatever the container's environment
# sets outranks it. Everything the compose stack already gives is therefore left
# commented out, its value kept visible after the `#`: uncommenting it here would
# change nothing, because the stack's value wins anyway.

# Network Configuration
# HTTP_STATUS_HOST=0.0.0.0
# HTTP_STATUS_PORT=8090
# HTTP/1.1 keep-alive for status server (true|false). When false, each response ends with Connection: close after the body is fully sent.
# HTTP_STATUS_KEEP_ALIVE=true
# FRONTEND_HTML_HOST=0.0.0.0
# FRONTEND_HTML_PORT=8093
# FRONTEND_DIST_PATH=
# WORKER_COMM_HOST=0.0.0.0
# WORKER_COMM_PORT=8091
# WEBSOCKET_HOST=0.0.0.0
# WEBSOCKET_PORT=8092
# CLI <-> daemon command channel (dedicated socket, internal to the docker network)
# COMMAND_HOST=0.0.0.0
# COMMAND_PORT=8094

# Trusted proxies (HIL-680). The networks whose X-Real-IP header is believed to
# name the visitor, comma-separated, each in CIDR notation and a single address
# written as /32 or /128. Empty is the default and trusts nobody: the address a
# connection is counted and logged by is then the address of its TCP peer, which
# is correct for a daemon facing the network directly - and the only safe answer
# for one behind a proxy that was never named here, since a header anyone may
# send cannot be the identity anti-abuse counts by. Put the network of your own
# nginx here; a chain in front of it (a CDN) is unrolled by nginx itself
# (set_real_ip_from / real_ip_header), not by the framework.
# HILOS_TRUSTED_PROXIES=

# Build timestamp carried in the WebSocket handshake welcome frame. The frontend
# compares it on every (re)connect and forces a page refresh on mismatch. The
# frontend build writes dist/build-timestamp.txt and the daemon picks it up at
# startup, so test/production get a real value automatically. Set this only to
# override; defaults to 'dev' (dev server, no build).
# HILOS_BUILD_TIMESTAMP=dev

# Vite dev only: the browser always requests a same-origin /chat/attachment (file
# downloads), so the session cookie rides along and no token appears in the URL.
# The Vite dev server forwards it to the daemon's HTTP router — the proxy target is
# set in docker-compose.local.yml (VITE_ATTACHMENT_TARGET, default http://chat-local:8090).
# In test/prod nginx proxies /chat/attachment instead. The WebSocket URL is separate (VITE_WS_URL).

# Chat attachments (optional overrides). Defaults are always under the demo/chat project: data/chat_attachments/{quarantine,published}.
# Docker (docker-compose.local.yml: ..:/app): /app/data/chat_attachments/... — same tree as data/logs, independent of DAEMON_LOG_FILE.
# CHAT_FILES_QUARANTINE_DIR=/custom/quarantine
# CHAT_FILES_PUBLISHED_DIR=/custom/published
# Internal nginx location that streams published files via X-Accel-Redirect (test/prod set it
# to /__chat_published). Empty (default) makes the daemon stream the bytes itself — correct for
# local/dev where no nginx sits in front of it.
# CHAT_FILES_XACCEL_LOCATION=/__chat_published

# OAuth login (HIL-281, HIL-419). Each provider is a client id/secret pair; leaving
# a pair empty selects the offline stub for THAT provider, so dev/e2e log in with no
# real round-trip, and a half-configured app still starts. Fill a pair to enable the
# real flow (register the callback URL with that provider). The callback address is
# one for the whole app — a single /auth/callback route, whoever is coming back.
# OAUTH_STATE_SECRET signs the stateless, session-bound `state` token — override
# the dev default in any real deployment.
# OAUTH_STATE_SECRET=change-me
# OAUTH_GITHUB_CLIENT_ID=
# OAUTH_GITHUB_CLIENT_SECRET=
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=
# OAUTH_REDIRECT_URI=/auth/callback

# Magic-link sign-in (HIL-417). The screen a mailed sign-in link comes back to, with
# the address and its token appended as query params. It travels in a letter, so it
# has to be absolute — a path would resolve against the mail client, not the app.
# The default points at the local front end; set it to the deployed origin.
# HILOS_MAGIC_LINK_URL=http://localhost:5173/auth/magic

# Mail delivery (HIL-197). Leaving MAIL_SMTP_HOST empty (and MAIL_TRANSPORT unset)
# selects the file transport, which writes each message as a .eml under MAIL_FILE_DIR
# instead of talking to a relay — the fallback for an environment with no docker.
# The dockerized stands do not use it: each compose file pins MAIL_TRANSPORT=smtp at
# its own Mailpit interceptor, so nothing here is what dev or e2e actually reads (HIL-558).
# Set MAIL_TRANSPORT=smtp with a host/credentials to send for real; MAIL_SMTP_USERNAME
# and MAIL_SMTP_PASSWORD are env-only secrets (never DB settings). MAIL_WORKER_COUNT sizes
# the sharded hilos_mail agent pool; MAIL_MAX_CONCURRENT bounds one agent's live dialogs.
# MAIL_TRANSPORT=
# MAIL_SMTP_HOST=
# MAIL_SMTP_PORT=587
# MAIL_SMTP_SECURITY=starttls
# MAIL_SMTP_USERNAME=
# MAIL_SMTP_PASSWORD=
# MAIL_FROM_ADDRESS=
# MAIL_FROM_NAME=
# MAIL_TIMEOUT_MS=10000
# MAIL_WORKER_COUNT=1
# MAIL_MAX_CONCURRENT=4
# MAIL_FILE_DIR=

# Container watchdog alert (HIL-617). The watchdog's OWN mail, and nothing to do
# with the application's MAIL_* settings: it has to be able to report itself on a
# box where the application mail is not configured at all, so it never borrows
# those values and never falls back to the file transport. It writes on exactly two occasions - the daemon failed to
# start DAEMON_FAILED_START_THRESHOLD times in a row, and the watchdog is exiting
# after a failure of its own. Leaving WATCHDOG_ALERT_SMTP_HOST, _FROM_ADDRESS or
# _TO_ADDRESS empty means "not configured": the watchdog names the missing
# variables in the log and sends nothing. One recipient only - fanning out to
# several is the relay's job.
# WATCHDOG_ALERT_SMTP_HOST=
# WATCHDOG_ALERT_SMTP_PORT=587
# WATCHDOG_ALERT_SMTP_SECURITY=starttls
# WATCHDOG_ALERT_SMTP_USERNAME=
# WATCHDOG_ALERT_SMTP_PASSWORD=
# WATCHDOG_ALERT_FROM_ADDRESS=
# WATCHDOG_ALERT_TO_ADDRESS=
# WATCHDOG_ALERT_TIMEOUT_MS=5000

# SMS delivery (HIL-285). Leaving SMS_ENDPOINT_URL empty (and SMS_PROVIDER unset)
# selects the stub provider, which sends nothing and logs only the masked number - a safe
# default for a project with no gateway, and not a way to read a code. Set an endpoint to
# send over HTTP; the operational gateway fields (method, auth mode, field map, success
# rule, from, timeout, max length) are admin settings on top of these env defaults, while
# SMS_API_KEY / SMS_API_PASSWORD are env-only secrets. SMS_WORKER_COUNT sizes the sharded
# hilos_sms agent pool. Nothing needs to be set here for a stand: the local, dev and test
# stacks point the endpoint at their own stand gateway (HIL-653), which forwards every
# text to Mailpit as a letter to <number>@sms.stand - so a code is read in the browser
# beside the mailed ones instead of dug out of a container.
# SMS_PROVIDER=
# SMS_ENDPOINT_URL=
# SMS_FROM=
# SMS_API_KEY=
# SMS_API_PASSWORD=
# SMS_TIMEOUT_MS=10000
# SMS_WORKER_COUNT=1

# Telegram Gateway: one-time login codes delivered to a phone over Telegram (HIL-492).
# Leaving TELEGRAM_GATEWAY_TOKEN empty leaves the channel unconfigured, and it then
# reports every number unreachable rather than failing - so the SMS button beside it
# keeps working and only the messenger is lost. TELEGRAM_GATEWAY_ENDPOINT_URL exists for
# the stands, which point it at their own stand gateway (HIL-653) and read the delivered
# code in Mailpit as a letter to <number>@telegram.stand; in production it is the default
# below. Nothing needs to be set here for a stand - the stacks carry both the address and
# a fake but non-empty token, which the gateway insists on so that a daemon sending no
# credentials fails there rather than in production. The token is an env-only secret; the
# sender username is shown to the recipient.
# TELEGRAM_GATEWAY_TOKEN=
# TELEGRAM_GATEWAY_ENDPOINT_URL=https://gatewayapi.telegram.org
# TELEGRAM_GATEWAY_SENDER_USERNAME=
# TELEGRAM_GATEWAY_TIMEOUT_MS=5000

# Database Configuration (optional for this demo)
# DB_HOST=hilos-mysql
# DB_PORT=3306
# DB_NAME=hilos_db
# DB_USER=hilos_user
# DB_PASSWORD=hilos_password
# DB_ROOT_PASSWORD=root_password

# Logging
DAEMON_LOG_FILE=/var/log/hilos/daemon.log
DAEMON_ERROR_LOG_FILE=/var/log/hilos/daemon-error.log

# Local LLM (Ollama). See docs/docker-ollama-gpu.md
# When demo runs in Docker and Ollama on host (framework or external): http://host.docker.internal:11434
# LLM_LOCAL_URL=http://host.docker.internal:11434

# ===================================
# Application Environment
# ===================================
# Canonical values (AppEnv): prod | staging | dev | local | test.
# Required: a node that names no APP_ENV refuses to start rather than call itself
# dev, which is the one answer that opens every test-only command on a port that
# authenticates nobody.
# APP_ENV=dev
