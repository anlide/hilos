events {
    worker_connections 1024;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    map $http_upgrade $connection_upgrade {
        default upgrade;
        '' close;
    }

    sendfile        on;
    keepalive_timeout  65;

    # HTTP server - redirect only to HTTPS
    server {
        listen 80;
        server_name localhost;
        return 301 https://$host$request_uri;
    }

    # HTTPS server
    server {
        listen 443 ssl;
        server_name localhost;
        root /usr/share/nginx/html;

        ssl_certificate     /etc/nginx/ssl/cert.pem;
        ssl_certificate_key /etc/nginx/ssl/key.pem;

        # Gzip compression
        gzip on;
        gzip_vary on;
        gzip_min_length 1024;
        gzip_types text/plain text/css text/xml text/javascript application/javascript application/json;

        # Trailing slash redirect to no-trailing-slash
        rewrite ^(.+)/$ $1 permanent;

        # robots.txt and sitemap.xml - static
        location = /robots.txt { try_files $uri =404; }
        location = /sitemap.xml { try_files $uri =404; }

        # Static assets
        location /assets/ {
            try_files $uri =404;
            expires 1y;
            add_header Cache-Control "public, immutable";
        }
        location ~* \.(jpg|jpeg|png|gif|ico|css|js|svg|woff|woff2|ttf|eot)$ {
            try_files $uri =404;
            expires 1y;
            add_header Cache-Control "public, immutable";
        }

        # WebSocket upgrade proxy for Docker E2E and HTTPS deployments.
        location /ws {
            proxy_pass http://${FRONTEND_HTML_UPSTREAM}:8092;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Host $host;
            proxy_read_timeout 3600s;
        }

        # Authenticated attachment download: the daemon validates the session
        # cookie and replies with X-Accel-Redirect; nginx then streams the file
        # from the internal location below. The cookie rides the proxied request
        # (same-origin), so no session token ever appears in the URL.
        location = /chat/attachment {
            proxy_pass http://${FRONTEND_HTML_UPSTREAM}:8090;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
        }

        # Internal target for the daemon's X-Accel-Redirect; never reached
        # directly. The published attachments directory is mounted here read-only.
        location /__chat_published/ {
            internal;
            alias /published/;
        }

        location = / {
            try_files /index.html =404;
        }

        # Known client-side deep links that are not prerendered.
        location = /profile {
            try_files /index.html =404;
        }
        location ~ ^/(user|bot)/[0-9]+$ {
            try_files /index.html =404;
        }

        # OAuth + magic-link relay routes (HIL-281/HIL-401): the provider redirect
        # and the emailed link land the browser on these client-side deep links,
        # which resolve the exchange over the socket and are not prerendered, so
        # they cold-load the SPA shell like the other deep links above.
        location ~ ^/auth/(callback|magic)$ {
            try_files /index.html =404;
        }

        # Hilos admin deep links cold-load the SPA shell; access control is
        # backend-side at the WS subscription, never by hiding the HTML.
        location /hilos {
            try_files /index.html =404;
        }

        # Prerendered/static routes; unknown public paths should stay 404.
        location / {
            try_files $uri $uri.html $uri/index.html =404;
        }

        # Security headers
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-XSS-Protection "1; mode=block" always;
    }
}
