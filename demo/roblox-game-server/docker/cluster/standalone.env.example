# Deployment interpolation for ONE component on ONE server, with Compose 2.40.3+.
# Copy outside the checkout, edit the addresses/paths, then from the demo directory:
#   docker compose --env-file /srv/hilos/standalone.env -p roblox-galera1 -f docker/cluster/database.yml config
#   docker compose --env-file /srv/hilos/standalone.env -p roblox-garbd -f docker/cluster/garbd.yml config
#   docker compose --env-file /srv/hilos/standalone.env -p roblox-proxy -f docker/cluster/haproxy.yml config
#   docker compose --env-file /srv/hilos/standalone.env -p roblox-m1 -f docker/cluster/node.yml config
#   docker compose --env-file /srv/hilos/standalone.env -p roblox-entry -f docker/cluster/entry.yml config
# Replace config with up -d --build after provisioning the inputs below. This does
# not install remote servers. Existing vendor and frontend builds are prerequisites.
# Paths below are host paths; relative paths resolve from docker/cluster, including
# the HILOS_CLUSTER_NODE_ENV and HILOS_CLUSTER_TEST_ENV_FILE selections.
# Use a distinct project name on each component when they share a Docker engine.
#
# --env-file supplies COMPOSE INTERPOLATION; it is not the node's runtime env_file.
# Before config/up, copy nodes/m1.env to the selected runtime file, then edit it.
# common.env loads first, the selected file last. Example runtime entries:
#   CLUSTER_NODE_ID=m1
#   CLUSTER_NODE_NAME=Master 1
#   CLUSTER_NODE_ROLE=master
#   CLUSTER_NODE_CAPABILITIES=
#   WORKER_MIN_MONOPOLISTIC=0
#   BACKUP_DIR=/app/data/backup-cluster/m1
#   DB_HOST=192.0.2.10
#   DB_PORT=3306
#   DB_DATABASE=hilos-demo-roblox-game-server-cluster
#   DB_USERNAME=hilos
#   DB_PASSWORD=replace-with-the-database-password
#   CLUSTER_PEER_HOST=0.0.0.0
#   CLUSTER_PEER_PORT=8095
#   CLUSTER_PEER_ADVERTISE=192.0.2.11:18095
#   CLUSTER_SEEDS=192.0.2.12:28095,192.0.2.13:38095,192.0.2.14:48095
#   CLUSTER_MASTER_SET=m1,m2,m3
#   CLUSTER_TLS_CA_FILE=/app/docker/tls/ca.pem
#   CLUSTER_TLS_CERT_FILE=/app/docker/tls/m1.pem
#   HILOS_TRUSTED_PROXIES=192.0.2.30/32
#   MAIL_SMTP_HOST=192.0.2.20
#   MAIL_SMTP_PORT=1025
# Provision the matching mutual-TLS files under the mounted project before starting;
# stand fixture certificates are for local testing. Each node needs its own runtime
# file and log/backup directory. Seeds must exclude that node's advertise endpoint.
# Runtime DB/peer settings go in the selected file, not in this interpolation file.
# No global CLUSTER_NODE_ID is used: local.yml fixes each service to nodes/<id>.env.
HILOS_CLUSTER_NODE_ENV=/srv/hilos/m1.env
HILOS_CLUSTER_LOG_DIR=/srv/hilos/logs/m1
# Every node AND the entry must see the same pre-provisioned shared export storage.
# This path only binds that storage; it provisions no NFS/Ceph or cross-server sync.
# The published files directory, data/files/published, is shared the same way through
# the project bind of the nodes and the entry's own bind of it.
HILOS_CLUSTER_DATA_EXPORT_DIR=/srv/hilos/shared/data_export
# Default, when unset, remains the stand's /dev/shm directory (lost on host reboot).
HILOS_CLUSTER_DB_DATA_DIR=/srv/hilos/mysql
# Local tooling only: read-only /app/tests/.env, process env still names cluster DB.
# The CLI carrier keeps /app/tests in tmpfs so a missing mount target cannot create
# a host tests/.env; test suites run in their own existing test services.
HILOS_CLUSTER_TEST_ENV_FILE=../../tests/.env

# Database component initialization credentials. Match the selected runtime file.
# A fresh or an existing cluster gets the Change Log journal when the part mounts
# /usr/local/bin/provision-change-log.sh (mysql/provision-change-log.sh) and it is run ONCE
# with root credentials on the first data member, after that member is Synced and before the
# nodes start; Galera replicates the journal to the other data members. The init bind of the
# local stand does this by itself, on galera1 of a fresh stand only.
DB_DATABASE=hilos-demo-roblox-game-server-cluster
DB_USERNAME=hilos
DB_PASSWORD=replace-with-the-database-password
MYSQL_ROOT_PASSWORD=replace-with-the-root-password

# One Galera data member, the one this file starts. Every member names the same cluster and
# the same address list: every data member and the arbitrator, comma-separated. The member
# raises a new cluster only when none of HILOS_GALERA_DATA_PEERS (the OTHER data members,
# space-separated, never the arbitrator) answers on 4567, and joins otherwise - so start the
# members one at a time. The parts publish only SQL: the replication ports 4567, 4568 and 4444
# and the agent port 9200 must be reachable between the servers by the operator's own means.
HILOS_GALERA_CLUSTER_NAME=hilos-roblox-game-server-cluster
HILOS_GALERA_CLUSTER_ADDRESS=192.0.2.21,192.0.2.22,192.0.2.23
HILOS_GALERA_NODE_NAME=galera1
HILOS_GALERA_NODE_ADDRESS=192.0.2.21
HILOS_GALERA_DATA_PEERS=192.0.2.22

# The arbitrator: the data members it joins, comma-separated, and the same cluster name.
HILOS_GALERA_DATA_MEMBERS=192.0.2.21,192.0.2.22

# The proxy: the two data members, and the node addresses each of them is given,
# space-separated (m1 and m3 to the first, m2 and s1 to the second).
HILOS_DB_MEMBER_1=192.0.2.21
HILOS_DB_MEMBER_2=192.0.2.22
HILOS_DB_CLIENTS_1="192.0.2.11 192.0.2.13"
HILOS_DB_CLIENTS_2="192.0.2.12 192.0.2.14"

# Bind on the server's interface; examples use documentation-only endpoint IPs.
HILOS_CLUSTER_BIND_ADDRESS=0.0.0.0
HILOS_CLUSTER_DB_PUBLISHED_PORT=3306
HILOS_CLUSTER_DB_PROXY_PUBLISHED_PORT=3306
HILOS_CLUSTER_PEER_PUBLISHED_PORT=18095
HILOS_CLUSTER_WS_PUBLISHED_PORT=18092
HILOS_CLUSTER_HTTP_PUBLISHED_PORT=18090
HILOS_CLUSTER_ENTRY_HTTP_PUBLISHED_PORT=80
HILOS_CLUSTER_ENTRY_HTTPS_PUBLISHED_PORT=443
# Worker IPC and command ports are deliberately not published.

# Full nginx endpoints: each master can use its own address and published ports.
HILOS_CLUSTER_WS_M1=192.0.2.11:18092
HILOS_CLUSTER_WS_M2=192.0.2.12:28092
HILOS_CLUSTER_WS_M3=192.0.2.13:38092
HILOS_CLUSTER_HTTP_M1=192.0.2.11:18090
HILOS_CLUSTER_HTTP_M2=192.0.2.12:28090
HILOS_CLUSTER_HTTP_M3=192.0.2.13:38090

# Existing stand namespace/weight knobs, for local.yml + tooling.yml through root.
# HILOS_STAND_SUFFIX=-s3
# HILOS_STAND_CPU_SHARES=64
# HILOS_STAND_NET_ROBLOX_GAME_SERVER_CLUSTER=58
# Do not use deployment interpolation with the local aggregate: it has fixed node
# identities and no published ports, but deployment DB/storage overrides are for
# standalone components. The shared local export and files volumes stay named volumes.
