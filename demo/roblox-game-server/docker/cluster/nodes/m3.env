CLUSTER_NODE_ID=m3
CLUSTER_NODE_NAME=Master 3
BACKUP_DIR=/app/data/backup-cluster/m3
HILOS_TRUSTED_PROXIES=10.${HILOS_STAND_NET_ROBLOX_GAME_SERVER_CLUSTER:-225}.0.30/32
CLUSTER_TLS_CERT_FILE=/app/docker/tls/m3.pem
CLUSTER_NODE_ROLE=master
# A working master: it votes and carries placed work. `worker` is the tag the probe fleet asks
# of its host; ram and slots make the node take placed work at all - a node that declares no
# key=value accepts none (HIL-445, rule 4), and every placed agent takes one of the slots it
# declares (HIL-447); 64 is far more than the stand places.
CLUSTER_NODE_CAPABILITIES=worker,ram=10,slots=64
CLUSTER_PEER_ADVERTISE=10.${HILOS_STAND_NET_ROBLOX_GAME_SERVER_CLUSTER:-225}.0.13:8095
CLUSTER_SEEDS=10.${HILOS_STAND_NET_ROBLOX_GAME_SERVER_CLUSTER:-225}.0.11:8095,10.${HILOS_STAND_NET_ROBLOX_GAME_SERVER_CLUSTER:-225}.0.12:8095,10.${HILOS_STAND_NET_ROBLOX_GAME_SERVER_CLUSTER:-225}.0.14:8095
# Placed work shares these regular workers (see s1.env).
WORKER_MIN_REGULAR=5
WORKER_MAX_REGULAR=5
