CLUSTER_NODE_ID=m1
CLUSTER_NODE_NAME=Master 1
# All nodes bind one demo tree at /app, so a shared backup directory would make an
# archive visible everywhere. Production keeps each node's archive directory local.
BACKUP_DIR=/app/data/backup-cluster/m1
HILOS_TRUSTED_PROXIES=10.${HILOS_STAND_NET_ROBLOX_GAME_SERVER_CLUSTER:-225}.0.30/32
CLUSTER_TLS_CERT_FILE=/app/docker/tls/m1.pem
CLUSTER_NODE_ROLE=master
# Empty on purpose: the framework gates placement on what a node DECLARES, never on its
# role (HIL-445). An empty string declares no capacity, and a node with no key=value
# accepts NO placed work by rule (HIL-448) - no fleet member, no policy-placed agent of
# this demo, nothing the policy places. The per-node agents (AgentScope::NODE) are not
# placed and need no capacity, so they still run here. The decision and what follows
# from it:
# docs/agents/architecture/daemon-lifecycle.md, "Who may carry placed work (HIL-445)"
# and "Consumable capacity and agent cost (HIL-448)".
CLUSTER_NODE_CAPABILITIES=
CLUSTER_PEER_ADVERTISE=10.${HILOS_STAND_NET_ROBLOX_GAME_SERVER_CLUSTER:-225}.0.11:8095
CLUSTER_SEEDS=10.${HILOS_STAND_NET_ROBLOX_GAME_SERVER_CLUSTER:-225}.0.12:8095,10.${HILOS_STAND_NET_ROBLOX_GAME_SERVER_CLUSTER:-225}.0.13:8095,10.${HILOS_STAND_NET_ROBLOX_GAME_SERVER_CLUSTER:-225}.0.14:8095
# The only node that carries no placed work keeps no warm monopolistic worker for it.
WORKER_MIN_MONOPOLISTIC=0
