CLUSTER_NODE_ID=s1
CLUSTER_NODE_NAME=Slave 1
BACKUP_DIR=/app/data/backup-cluster/s1
CLUSTER_TLS_CERT_FILE=/app/docker/tls/s1.pem
CLUSTER_NODE_ROLE=slave
# A worker with less room than the working masters (ram=4 against their ram=10), each with the
# same slots; see m2.env for what the tag, the ram and the slots are for.
CLUSTER_NODE_CAPABILITIES=worker,ram=4,slots=64
CLUSTER_PEER_ADVERTISE=10.${HILOS_STAND_NET_ROBLOX_GAME_SERVER_CLUSTER:-225}.0.14:8095
CLUSTER_SEEDS=10.${HILOS_STAND_NET_ROBLOX_GAME_SERVER_CLUSTER:-225}.0.11:8095,10.${HILOS_STAND_NET_ROBLOX_GAME_SERVER_CLUSTER:-225}.0.12:8095,10.${HILOS_STAND_NET_ROBLOX_GAME_SERVER_CLUSTER:-225}.0.13:8095
# Placed work shares these regular workers. A fleet member's synthetic job blocks its
# worker, so several of them keep the whole fleet ticking even when one node holds
# it all after a failover.
WORKER_MIN_REGULAR=5
WORKER_MAX_REGULAR=5
