# Simple Poll Demo Project Configuration

# Network Configuration. The daemon binds fixed in-container ports — the same
# for every demo, because the nginx template proxies /ws to :8092. The host
# side publishes them at shifted ports (see docker-compose.local.yml: defaults
# 8104 status / 8105 worker comm / 8106 websocket; override with
# HTTP_STATUS_HOST_PORT / WORKER_COMM_HOST_PORT / WEBSOCKET_HOST_PORT).
HTTP_STATUS_HOST=0.0.0.0
HTTP_STATUS_PORT=8090
WORKER_COMM_HOST=0.0.0.0
WORKER_COMM_PORT=8091
WEBSOCKET_HOST=0.0.0.0
WEBSOCKET_PORT=8092

# Build timestamp carried in the WebSocket handshake welcome frame.
# The frontend compares it on every (re)connect and forces a page refresh on mismatch.
# Bumped at frontend build time; defaults to 'dev' when unset.
# HILOS_BUILD_TIMESTAMP=dev

# Logging
DAEMON_LOG_FILE=/var/log/hilos/daemon.log
DAEMON_ERROR_LOG_FILE=/var/log/hilos/daemon-error.log

# Workers: one monopolistic worker hosts the poll agent; one regular spare.
WORKER_MIN_REGULAR=1
WORKER_MIN_MONOPOLISTIC=1
WORKER_MAX_REGULAR=4
