# Shared runtime values. The selected node identity file is loaded after this file.
# APP_ENV=dev keeps the cluster probes and stand-only commands available; the CLI
# command carrier is the only service that runs as APP_ENV=test.
APP_ENV=dev
HILOS_PROJECT_TIME_ZONE=Europe/Warsaw
# The nightly rotation carries daemon.log away under a run; a test that needs a rotation calls it itself.
LOG_ROTATION_CRON=0 3 29 2 *
DB_HOST=file-gallery-manager-cluster-mysql
DB_PORT=3306
DB_DATABASE=hilos-demo-file-gallery-manager-cluster
DB_USERNAME=hilos
DB_PASSWORD=hilos_pass
MAIL_TRANSPORT=smtp
MAIL_SMTP_HOST=file-gallery-manager-cluster-mailpit
MAIL_SMTP_PORT=1025
MAIL_SMTP_SECURITY=none
MAIL_FROM_ADDRESS=notifications@file-gallery-manager.test
MAIL_FROM_NAME=Hilos File Gallery Manager
HTTP_STATUS_HOST=0.0.0.0
HTTP_STATUS_PORT=8090
WORKER_COMM_HOST=0.0.0.0
WORKER_COMM_PORT=8091
COMMAND_HOST=0.0.0.0
COMMAND_PORT=8094
WEBSOCKET_HOST=0.0.0.0
WEBSOCKET_PORT=8092
HILOS_DAEMON_HOST=127.0.0.1
CLUSTER_ENABLED=true
CLUSTER_PEER_HOST=0.0.0.0
CLUSTER_PEER_PORT=8095
CLUSTER_MASTER_SET=m1,m2
CLUSTER_ELECTION_TIMEOUT_MIN_MS=1500
CLUSTER_ELECTION_TIMEOUT_MAX_MS=3000
CLUSTER_HEARTBEAT_INTERVAL_MS=500
CLUSTER_LINK_KEEPALIVE_INTERVAL_MS=1000
CLUSTER_LINK_TIMEOUT_MS=6000
CLUSTER_FAILOVER_GRACE_MS=6000
CLUSTER_SLAVE_WORK_GRACE_MS=4000
CLUSTER_TLS_CA_FILE=/app/docker/tls/ca.pem
WORKER_MIN_REGULAR=1
WORKER_MAX_REGULAR=1
WORKER_MIN_MONOPOLISTIC=1
