# Environment configuration
.env
.env.local
# tests/.env is tracked: the test stack runs with the same values on every machine
!tests/.env
.env.*.local

# PHPUnit
tests/.phpunit.cache/

# Vendor
vendor/

# Node.js
node_modules/
npm-debug.log*

# Frontend build output
/frontend/dist/
/frontend/dist-prerender/

# Vite dependency-optimizer cache (a cold container start can drop it at the
# package root instead of node_modules/.vite)
/frontend/.vite/

# Playwright
tests/e2e/test-results/
tests/e2e/playwright-report/

# Local and test runtime data
/data/
