{
  "name": "demo-binance-btc-tracker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Binance BTC tracker demo — an end project that consumes the Hilos frontend SDK (@hilos/vue).",
  "scripts": {
    "predev": "node ../../../framework/frontend/scripts/generate-license-inventory.mjs",
    "dev": "vite",
    "prebuild": "node ../../../framework/frontend/scripts/prebuild-sdk.mjs vue && node ../../../framework/frontend/scripts/generate-license-inventory.mjs",
    "build": "vite build && vite build --ssr scripts/prerenderEntry.ts --outDir dist-prerender && node dist-prerender/prerenderEntry.js && node node_modules/@hilos/core/bin/theme-head.mjs dist",
    "preview": "vite preview",
    "precheck": "node ../../../framework/frontend/scripts/generate-license-inventory.mjs",
    "check": "vue-tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@hilos/core": "file:../../../framework/frontend/core",
    "@hilos/vue": "file:../../../framework/frontend/vue",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.0",
    "prettier": "^3.9.10",
    "sass-embedded": "^1.107.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.3.7",
    "vue-tsc": "^3.3.14"
  }
}
