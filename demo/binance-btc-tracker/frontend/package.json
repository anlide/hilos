{
  "name": "demo-binance-btc-tracker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Binance BTC tracker demo — an end project that consumes the Hilos frontend SDK (@hilos/vue).",
  "scripts": {
    "predev": "node ../../../framework/frontend/scripts/generate-license-inventory.mjs",
    "dev": "vite",
    "prebuild": "node ../../../framework/frontend/scripts/prebuild-sdk.mjs vue && node ../../../framework/frontend/scripts/generate-license-inventory.mjs",
    "build": "vite build && vite build --ssr scripts/prerenderEntry.ts --outDir dist-prerender && node dist-prerender/prerenderEntry.js",
    "preview": "vite preview",
    "precheck": "node ../../../framework/frontend/scripts/generate-license-inventory.mjs",
    "check": "vue-tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@hilos/core": "file:../../../framework/frontend/core",
    "@hilos/vue": "file:../../../framework/frontend/vue",
    "vue": "^3.5.35"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "sass-embedded": "^1.83.0",
    "typescript": "^6.0.3",
    "vite": "^7.0.0",
    "vue-tsc": "^3.3.4"
  }
}
