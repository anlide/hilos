# Shared runtime values; the selected node env follows this file.
# APP_ENV is required of every node (HIL-566), and the value is `dev`, not `test`:
# `dev` is not production-like, so the nodes admit the test-only commands this
# harness drives, and the framework's cluster probes start only on a clustered
# node of a non-production environment. Only the cli container runs as
# APP_ENV=test. Local node files retain this shared database; a standalone
# deployment overrides its address and credentials in the selected node file.
APP_ENV=dev
HILOS_DEFAULT_LANGUAGE=en
DB_HOST=binance-btc-tracker-cluster-mysql
DB_PORT=3306
# One schema for the whole stand, nodes and CLI alike: the cluster model is
# "one database per cluster", and a node that cannot see its neighbour's row
# cannot be asked about it (HIL-712).
DB_DATABASE=hilos-demo-binance-btc-tracker-cluster
DB_USERNAME=hilos
DB_PASSWORD=hilos_pass
HTTP_STATUS_HOST=0.0.0.0
HTTP_STATUS_PORT=8090
WORKER_COMM_HOST=0.0.0.0
WORKER_COMM_PORT=8091
COMMAND_HOST=0.0.0.0
COMMAND_PORT=8094
MAIL_TRANSPORT=smtp
MAIL_SMTP_HOST=binance-btc-tracker-cluster-mailpit
MAIL_SMTP_PORT=1025
MAIL_SMTP_SECURITY=none
MAIL_FROM_ADDRESS=notifications@binance-btc-tracker.test
MAIL_FROM_NAME="BTC Tracker"
# The demo has pages, so a node refuses to start without its WebSocket listener; bound in the
# container at the port every demo uses, and published nowhere on the host. Browsers
# enter through the one nginx entry; scenario 10 attaches through the CLI.
WEBSOCKET_HOST=0.0.0.0
WEBSOCKET_PORT=8092
# Every node addresses itself, so an operator command run with `docker exec` in
# any node's container (admin:create / admin:grant / admin:revoke /
# protected-mode:open, and the harness's test:cluster:inspect) reaches that
# node's command channel over loopback.
# A command answered by an agent on another node returns to this asking node (HIL-1232).
HILOS_DAEMON_HOST=127.0.0.1
CLUSTER_ENABLED=true
CLUSTER_PEER_HOST=0.0.0.0
CLUSTER_PEER_PORT=8095
CLUSTER_MASTER_SET=m1,m2,m3
# CLUSTER_SEEDS is set in each nodes/*.env file, each excluding the node's own advertise
# address: a node must never dial itself (the self-link collapse tears the daemon
# down). Gossip admits every other peer from any one live seed.
CLUSTER_ELECTION_TIMEOUT_MIN_MS=1500
CLUSTER_ELECTION_TIMEOUT_MAX_MS=3000
CLUSTER_HEARTBEAT_INTERVAL_MS=500
CLUSTER_LINK_KEEPALIVE_INTERVAL_MS=1000
CLUSTER_LINK_TIMEOUT_MS=6000
CLUSTER_FAILOVER_GRACE_MS=6000
CLUSTER_SLAVE_WORK_GRACE_MS=4000
# Every link between nodes is mutual TLS (HIL-1034): each node trusts the stand's authority
# and presents its own certificate, set in nodes/*.env as CLUSTER_TLS_CERT_FILE. The files in
# docker/tls/ are stand fixtures issued by the framework's cluster:tls:* commands against an
# authority of this stand alone; how to reissue them is in demo/binance-btc-tracker/README.md.
CLUSTER_TLS_CA_FILE=/app/docker/tls/ca.pem
WORKER_MIN_REGULAR=1
WORKER_MAX_REGULAR=1
WORKER_MIN_MONOPOLISTIC=1
