CLUSTER_NODE_ID=s2
BACKUP_DIR=/app/data/backup-cluster/s2
CLUSTER_TLS_CERT_FILE=/app/docker/tls/s2.pem
CLUSTER_NODE_ROLE=slave
# The same as s1's, and for the same reasons; see the comment there.
CLUSTER_NODE_CAPABILITIES=worker,ram=10,slots=64
CLUSTER_PEER_ADVERTISE=10.${HILOS_STAND_NET_BINANCE_BTC_TRACKER_CLUSTER:-221}.0.15:8095
CLUSTER_SEEDS=10.${HILOS_STAND_NET_BINANCE_BTC_TRACKER_CLUSTER:-221}.0.11:8095,10.${HILOS_STAND_NET_BINANCE_BTC_TRACKER_CLUSTER:-221}.0.12:8095,10.${HILOS_STAND_NET_BINANCE_BTC_TRACKER_CLUSTER:-221}.0.13:8095,10.${HILOS_STAND_NET_BINANCE_BTC_TRACKER_CLUSTER:-221}.0.14:8095
# Regular workers the fleet members share on this node; see s1.
WORKER_MIN_REGULAR=5
WORKER_MAX_REGULAR=5
