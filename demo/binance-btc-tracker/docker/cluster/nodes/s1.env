CLUSTER_NODE_ID=s1
BACKUP_DIR=/app/data/backup-cluster/s1
CLUSTER_TLS_CERT_FILE=/app/docker/tls/s1.pem
CLUSTER_NODE_ROLE=slave
# `worker` is the tag the probe fleet asks of its host. The ram and the slots are there so
# the node takes placed work at all: a node that declares no key=value accepts none
# (HIL-445, rule 4), and every placed agent takes one of the slots it declares (HIL-447),
# so without them neither the fleet nor this demo's policy-placed agents would land
# anywhere; 64 is far more than the stand places. Nothing on this stand spends ram, so
# both slaves declare the same; unequal room is the shape of ecommerce-shop's stand.
CLUSTER_NODE_CAPABILITIES=worker,ram=10,slots=64
CLUSTER_PEER_ADVERTISE=10.${HILOS_STAND_NET_BINANCE_BTC_TRACKER_CLUSTER:-221}.0.14:8095
CLUSTER_SEEDS=10.${HILOS_STAND_NET_BINANCE_BTC_TRACKER_CLUSTER:-221}.0.11:8095,10.${HILOS_STAND_NET_BINANCE_BTC_TRACKER_CLUSTER:-221}.0.12:8095,10.${HILOS_STAND_NET_BINANCE_BTC_TRACKER_CLUSTER:-221}.0.13:8095,10.${HILOS_STAND_NET_BINANCE_BTC_TRACKER_CLUSTER:-221}.0.15:8095
# Fleet members share these regular workers. A member's synthetic job blocks its
# worker, so several of them keep the whole fleet ticking even when one node holds
# it all after a failover.
WORKER_MIN_REGULAR=5
WORKER_MAX_REGULAR=5
