CLUSTER_NODE_ID=m2
BACKUP_DIR=/app/data/backup-cluster/m2
HILOS_TRUSTED_PROXIES=10.${HILOS_STAND_NET_BINANCE_BTC_TRACKER_CLUSTER:-221}.0.30/32
CLUSTER_TLS_CERT_FILE=/app/docker/tls/m2.pem
CLUSTER_NODE_ROLE=master
# Masters declare no placement capacity; see m1.env.
CLUSTER_NODE_CAPABILITIES=
CLUSTER_PEER_ADVERTISE=10.${HILOS_STAND_NET_BINANCE_BTC_TRACKER_CLUSTER:-221}.0.12:8095
CLUSTER_SEEDS=10.${HILOS_STAND_NET_BINANCE_BTC_TRACKER_CLUSTER:-221}.0.11:8095,10.${HILOS_STAND_NET_BINANCE_BTC_TRACKER_CLUSTER:-221}.0.13:8095,10.${HILOS_STAND_NET_BINANCE_BTC_TRACKER_CLUSTER:-221}.0.14:8095,10.${HILOS_STAND_NET_BINANCE_BTC_TRACKER_CLUSTER:-221}.0.15:8095
WORKER_MIN_MONOPOLISTIC=0
