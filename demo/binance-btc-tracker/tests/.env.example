# Test environment configuration
# Copy to tests/.env (`composer run setup-env` does this) and adjust if needed
# (e.g. DB_HOST=localhost and DB_PORT=33068 when running PHPUnit from host)

APP_ENV=test
DB_HOST=binance-btc-tracker-mysql-test
DB_PORT=3306
DB_DATABASE=hilos-demo-binance-btc-tracker-test
DB_USERNAME=hilos
DB_PASSWORD=hilos_pass

# Anti-abuse throttling is off in tests: the suites sign in and request codes far
# faster than a human ever would, so the ladder would refuse them for behaving like
# the tests they are (HIL-420).
HILOS_AUTH_THROTTLE_ENABLED=false
