# Local host-port overrides for the simple-todo demo — copy to docker/.env.
#
# Compose reads a `.env` from THIS directory (docker/) before any container
# exists and uses it to interpolate the ${VAR:-default} host-port publishes in
# docker-compose.local.yml. This is NOT the container env_file — that is the
# demo's ../.env, which only reaches container environments. A host-port value
# set in ../.env is silently ignored; set it here to actually move the port.
#
# docker/.env is gitignored (host-specific). Leave it absent, or leave a knob
# below commented, and compose keeps the default shown — no setup step is needed
# on a fresh clone. Uncomment and change a knob to republish that service on a
# different host port (e.g. to dodge a port already taken on this host).

# Bind address for every host publish in this stack. The default 127.0.0.1
# keeps a fresh clone closed — MySQL, phpMyAdmin, nginx and the dev server are
# reachable only from this machine. Set it ONLY on a host that must expose the
# stack to a LAN or tailnet (e.g. 0.0.0.0, or a specific interface address).
# A bogus value fails at `up` with docker's own "bind: cannot assign requested
# address". On a host running the preview lane, leave this alone and reach the
# stack through *.hilos — Caddy proxies 127.0.0.1, so moving it breaks *.hilos.
# HILOS_BIND_HOST=127.0.0.1

# Daemon status / worker-comm / websocket, published to the host (shifted per
# demo so stacks coexist; simple-todo owns 8098-8100):
# HTTP_STATUS_HOST_PORT=8098
# WORKER_COMM_HOST_PORT=8099
# WEBSOCKET_HOST_PORT=8100

# MySQL, phpMyAdmin, nginx HTTPS, and the Vite dev server:
# MYSQL_HOST_PORT=33063
# PHPMYADMIN_PORT=8081
# NGINX_HTTPS_PORT=444
# FRONTEND_DEV_PORT=5174

# ===================================
# Application Environment
# ===================================
# Canonical values (AppEnv): prod | staging | dev | local | test.
# Required: a node that names no APP_ENV refuses to start rather than call itself
# dev, which is the one answer that opens every test-only command on a port that
# authenticates nobody.
APP_ENV=dev
