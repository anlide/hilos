CLUSTER_NODE_ID=s1
CLUSTER_TLS_CERT_FILE=/app/docker/tls/s1.pem
CLUSTER_NODE_ROLE=slave
# Scenario 18 fills the unequal room with ram=2 ballast; 64 slots remain ample.
CLUSTER_NODE_CAPABILITIES=worker,ram=10,slots=64
CLUSTER_PEER_ADVERTISE=10.${HILOS_STAND_NET_ECOMMERCE_SHOP_CLUSTER:-222}.0.14:8095
CLUSTER_SEEDS=10.${HILOS_STAND_NET_ECOMMERCE_SHOP_CLUSTER:-222}.0.11:8095,10.${HILOS_STAND_NET_ECOMMERCE_SHOP_CLUSTER:-222}.0.15:8095
WORKER_MIN_REGULAR=5
WORKER_MAX_REGULAR=5
