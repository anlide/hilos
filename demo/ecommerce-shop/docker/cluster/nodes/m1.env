CLUSTER_NODE_ID=m1
CLUSTER_TLS_CERT_FILE=/app/docker/tls/m1.pem
CLUSTER_NODE_ROLE=master
# The master declares no placement capacity; placement is carried by the slaves.
CLUSTER_NODE_CAPABILITIES=
CLUSTER_PEER_ADVERTISE=10.${HILOS_STAND_NET_ECOMMERCE_SHOP_CLUSTER:-222}.0.11:8095
CLUSTER_SEEDS=10.${HILOS_STAND_NET_ECOMMERCE_SHOP_CLUSTER:-222}.0.14:8095,10.${HILOS_STAND_NET_ECOMMERCE_SHOP_CLUSTER:-222}.0.15:8095
WORKER_MIN_MONOPOLISTIC=0
