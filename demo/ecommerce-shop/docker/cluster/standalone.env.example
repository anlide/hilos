# Interpolation for one ecommerce database or node on a server; Compose 2.40.3+.
# From demo/ecommerce-shop, copy this file outside the checkout and edit its paths:
#   docker compose --env-file /srv/hilos/ecommerce.env -p ecommerce-db -f docker/cluster/database.yml config
#   docker compose --env-file /srv/hilos/ecommerce.env -p ecommerce-m1 -f docker/cluster/node.yml config
# Replace config with up -d --build after provisioning the inputs below. Vendor and
# frontend builds remain existing prerequisites; this does not install remote hosts.
# Compose --env-file supplies interpolation. The selected node env_file is a separate
# runtime file loaded after common.env; copy nodes/m1.env and edit the copy per server.
# Host bind paths and selected runtime env paths resolve from docker/cluster.
# Use a different Compose project for each component sharing a Docker engine.
#
# The selected runtime file for m1 includes entries like these (edit for the real hosts):
#   APP_ENV=dev
#   CLUSTER_NODE_ID=m1
#   CLUSTER_NODE_ROLE=master
#   CLUSTER_NODE_CAPABILITIES=
#   CLUSTER_PEER_HOST=0.0.0.0
#   CLUSTER_PEER_PORT=8095
#   CLUSTER_PEER_ADVERTISE=192.0.2.11:18095
#   CLUSTER_SEEDS=192.0.2.14:28095,192.0.2.15:38095
#   CLUSTER_MASTER_SET=m1
#   CLUSTER_TLS_CA_FILE=/app/docker/tls/ca.pem
#   CLUSTER_TLS_CERT_FILE=/app/docker/tls/m1.pem
#   DB_HOST=192.0.2.10
#   DB_PORT=3306
#   DB_DATABASE=hilos-demo-ecommerce-shop-cluster
#   DB_USERNAME=hilos
#   DB_PASSWORD=replace-with-the-database-password
# Provision matching TLS files under the mounted project before starting. Seeds exclude
# the node's own advertise endpoint. s1 and s2 use their matching nodes/*.env identities.
# The database and every node need their own host checkout and log/data directories.
HILOS_CLUSTER_NODE_ENV=/srv/hilos/m1.env
HILOS_CLUSTER_LOG_DIR=/srv/hilos/logs/m1
HILOS_CLUSTER_DB_DATA_DIR=/srv/hilos/mysql
# Used by the local CLI carrier only; process DB variables point at the cluster schema.
HILOS_CLUSTER_TEST_ENV_FILE=../../tests/.env.example

# Database initialization credentials. Keep these aligned with each node's runtime file.
DB_DATABASE=hilos-demo-ecommerce-shop-cluster
DB_USERNAME=hilos
DB_PASSWORD=replace-with-the-database-password
MYSQL_ROOT_PASSWORD=replace-with-the-root-password

# Bind only published database, peer, WebSocket and status HTTP ports on the server.
HILOS_CLUSTER_BIND_ADDRESS=0.0.0.0
HILOS_CLUSTER_DB_PUBLISHED_PORT=3306
HILOS_CLUSTER_PEER_PUBLISHED_PORT=18095
HILOS_CLUSTER_WS_PUBLISHED_PORT=18092
HILOS_CLUSTER_HTTP_PUBLISHED_PORT=18090
# Worker IPC and command ports are deliberately not published.

# Existing stand namespace/weight knobs, consumed by the root include and node env files.
# HILOS_STAND_SUFFIX=-s3
# HILOS_STAND_CPU_SHARES=64
# HILOS_STAND_NET_ECOMMERCE_SHOP_CLUSTER=56
# Do not apply deployment DB, log or published-port selections to the local aggregate.
