<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/11.0/phpunit.xsd"
         bootstrap="../backend/Bootstrap/phpunit.php"
         cacheDirectory="/tmp/hilos-framework-phpunit-cache"
         colors="true"
         failOnDeprecation="true"
         failOnNotice="true"
         failOnWarning="true"
         failOnPhpunitWarning="true">
    <source>
        <include>
            <directory>../backend</directory>
        </include>
    </source>
    <testsuites>
        <testsuite name="unit">
            <directory>Unit</directory>
        </testsuite>
        <testsuite name="integration">
            <directory>Integration</directory>
        </testsuite>
    </testsuites>
    <php>
        <!-- The unit suite runs in one process and outgrew 512M: the code style guard's source
             index ran out of memory in a full run (2026-11-20). A manual run that names no test
             suite runs unit and integration together under this limit. -->
        <ini name="memory_limit" value="1G"/>
        <env name="APP_ENV" value="test"/>
    </php>
    <extensions>
        <bootstrap class="Hilos\Testing\ProcessEnvironment\ProcessEnvironmentExtension"/>
        <bootstrap class="Hilos\Testing\TimeLimit\TestTimeLimitExtension"/>
    </extensions>
</phpunit>
