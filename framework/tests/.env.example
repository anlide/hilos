# Optional: copy to .env for framework integration tests (MySQL).
# PHPUnit runs in hilos-cli-test (see root composer.json test:framework:*); DB_* is set in compose for that service.
# Start DB first: composer run test:framework:up, then composer run test:framework:integration.
# If you run PHP on the host (not supported by project scripts), use 127.0.0.1 and port 33062 after test:framework:up.

DB_HOST=127.0.0.1
DB_PORT=33062
DB_DATABASE=hilos-framework-test
DB_USERNAME=hilos
DB_PASSWORD=hilos_pass
