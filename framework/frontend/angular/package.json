{
  "name": "@hilos/angular",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Angular view layer over @hilos/core — adapts the core stores to Angular via signals.",
  "main": "./dist/fesm2022/hilos-angular.mjs",
  "module": "./dist/fesm2022/hilos-angular.mjs",
  "types": "./dist/types/hilos-angular.d.ts",
  "files": [
    "dist",
    "src/hilos-styles.scss",
    "base/package.json",
    "admin-views/package.json",
    "admin/analytics/package.json",
    "admin/appearance/package.json",
    "admin/backup/package.json",
    "admin/billing/package.json",
    "admin/change-log/package.json",
    "admin/communications/package.json",
    "admin/daemon/package.json",
    "admin/dashboard/package.json",
    "admin/i18n/package.json",
    "admin/legal/package.json",
    "admin/logs/package.json",
    "admin/maintenance/package.json",
    "admin/mcp-skills/package.json",
    "admin/moderation/package.json",
    "admin/roles/package.json",
    "admin/security/package.json",
    "admin/settings/package.json",
    "admin/sil/package.json",
    "admin/users/package.json"
  ],
  "scripts": {
    "check": "npm run check:types && npm run check:templates",
    "check:types": "tsc --noEmit -p tsconfig.json",
    "check:templates": "ngc --noEmit -p tsconfig.build.json",
    "test": "vitest run",
    "prebuild": "node ../scripts/prebuild-sdk.mjs core",
    "build": "ng-packagr -p ng-package.json -c tsconfig.build.json",
    "test:dist": "node test/packaging.smoke.mjs",
    "test:dist:consumer": "node test/packaging.consumer.mjs"
  },
  "dependencies": {
    "@hilos/core": "*",
    "tslib": "^2.3.0"
  },
  "peerDependencies": {
    "@angular/common": "^22",
    "@angular/core": "^22",
    "bootstrap": "^5.3.3",
    "bootstrap-icons": "^1.13.1"
  },
  "devDependencies": {
    "@angular/compiler": "22.2.3",
    "@angular/compiler-cli": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "jsdom": "^29.1.1",
    "ng-packagr": "^22.0.0"
  }
}
