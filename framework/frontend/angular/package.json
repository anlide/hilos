{
  "name": "@hilos/angular",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Angular view layer over @hilos/core — adapts the core stores to Angular via signals.",
  "main": "./dist/fesm2022/hilos-angular.mjs",
  "module": "./dist/fesm2022/hilos-angular.mjs",
  "types": "./dist/types/hilos-angular.d.ts",
  "files": [
    "dist",
    "src/hilos-styles.scss"
  ],
  "scripts": {
    "check": "npm run check:types && npm run check:templates",
    "check:types": "tsc --noEmit -p tsconfig.json",
    "check:templates": "ngc --noEmit -p tsconfig.build.json",
    "test": "vitest run",
    "prebuild": "node ../scripts/prebuild-sdk.mjs core",
    "build": "ng-packagr -p ng-package.json -c tsconfig.build.json"
  },
  "dependencies": {
    "@hilos/core": "*",
    "tslib": "^2.3.0"
  },
  "peerDependencies": {
    "@angular/common": "^22",
    "@angular/core": "^22",
    "bootstrap": "^5.3.3",
    "bootstrap-icons": "^1.13.1"
  },
  "devDependencies": {
    "@angular/compiler": "22.0.1",
    "@angular/compiler-cli": "22.0.1",
    "@angular/platform-browser": "22.0.1",
    "jsdom": "^29.1.1",
    "ng-packagr": "^22.0.0"
  }
}
