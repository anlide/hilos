{
  "name": "@hilos/vue",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Vue view layer over @hilos/core — the Hilos frontend SDK.",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "check": "vue-tsc --noEmit -p tsconfig.json",
    "build": "vite build && vue-tsc --emitDeclarationOnly -p tsconfig.build.json"
  },
  "dependencies": {
    "@hilos/core": "*"
  },
  "peerDependencies": {
    "vue": "^3"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "vite": "^7.0.0",
    "vue": "^3.5.35",
    "vue-tsc": "^3.3.4"
  }
}
