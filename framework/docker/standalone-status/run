#!/bin/sh
# Disposable test tooling, with a read-only startup observer in the host shell.
set -eu
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
repo=$(CDPATH= cd -- "$here/../../.." && pwd -P)
if [ -n "${DOCKER_CONTEXT:-}" ]; then
    endpoint=$(docker context inspect "$DOCKER_CONTEXT" --format '{{.Endpoints.docker.Host}}')
elif [ -n "${DOCKER_HOST:-}" ]; then
    endpoint=$DOCKER_HOST
else
    endpoint=$(docker context inspect --format '{{.Endpoints.docker.Host}}')
fi
case "$endpoint" in
    unix:///*) socket=${endpoint#unix://} ;;
    *) echo 'standalone-status requires a local Unix Docker endpoint' >&2; exit 2 ;;
esac
[ -S "$socket" ] && [ -r "$socket" ] && [ -w "$socket" ]
unset DOCKER_CONTEXT DOCKER_HOST DOCKER_TLS_VERIFY DOCKER_CERT_PATH
state=$(mktemp -d /tmp/hilos-standalone-status.XXXXXXXX)
chmod 777 "$state"
observer_pid=
finish() {
    rc=$?
    trap - EXIT
    if [ -n "$observer_pid" ]; then
        touch "$state/startup-stop" || true
        kill -TERM "$observer_pid" 2>/dev/null || true
        # Every observer operation has a subsecond deadline; stop skips final sampling.
        wait "$observer_pid" || true
    fi
    if [ -f "$state/startup-request.json" ]; then
        python3 -B "$state/startup_observer.py" handoff "$state" \
            "$repo/demo/binance-btc-tracker/tests/e2e/test-results/standalone-status" || \
            echo "standalone-status startup artifact handoff failed: $state" >&2
    fi
    # Preserve the existing independent-recovery retain/remove decision.
    if [ ! -f "$state/manifest.json" ] || [ -f "$state/finished" ]; then
        rm -rf "$state"
    fi
    exit "$rc"
}
trap finish EXIT
case "${1:-}" in
    cycle|e2e)
        cp "$here/startup_observer.py" "$state/startup_observer.py"
        if command -v python3 >/dev/null 2>&1; then
            python3 -B "$state/startup_observer.py" observe "$state" "$endpoint" &
            observer_pid=$!
        else
            echo '{"status":"unavailable","reason":"Host python3 is unavailable"}' > "$state/startup-unavailable.json"
        fi
        ;;
esac
docker --host "$endpoint" build --iidfile "$state/image" \
    -f "$repo/framework/docker/Dockerfile.cluster-harness" "$repo/framework/docker" >&2
image=$(cat "$state/image")
set -- "$image" python3 "$here/runner.py" "$@"
port_vars=$(php -r 'require $argv[1]; echo implode(" ", STAND_INSTANCE_PORT_VARS);' "$repo/scripts/stand-instance.php")
for name in HILOS_STAND_SUFFIX HILOS_STAND_CPU_SHARES HILOS_STAND_NET_BINANCE_BTC_TRACKER HILOS_E2E_TIMEOUT_SCALE $port_vars; do
    value=$(printenv "$name" || true)
    [ -z "$value" ] || set -- --env "$name=$value" "$@"
done
docker --host "$endpoint" run --rm --init \
    --mount "type=bind,source=$repo,target=$repo" \
    --mount "type=bind,source=$socket,target=$socket" \
    --mount "type=bind,source=$state,target=$state" \
    --workdir "$repo/demo/binance-btc-tracker" \
    --env "DOCKER_HOST=$endpoint" --env "STATUS_CONTROL_DIR=$state" \
    --env "STATUS_HARNESS_IMAGE=$image" "$@"
