+/* Retire native callbacks before dropping their PHP base/context dependencies. */
+void php_event_bevent_release(php_event_bevent_t *bev)/*{{{*/
+{
+	struct bufferevent *bevent = bev->bevent;
+#ifdef HAVE_EVENT_OPENSSL_LIB
+	SSL *ssl;
+#endif
+
+	/* Clear first: releasing native state must be idempotent, including reentry. */
+	bev->bevent = NULL;
+	if (!bevent || bev->_internal) {
+		/* An HTTP connection owns an internal wrapper's native handle. */
+		return;
+	}
+
+	bufferevent_setcb(bevent, NULL, NULL, NULL, NULL);
+	bufferevent_disable(bevent, EV_READ | EV_WRITE);
+#ifdef HAVE_EVENT_OPENSSL_LIB
+	ssl = bufferevent_openssl_get_ssl(bevent);
+	if (ssl && (Z_ISUNDEF(bev->underlying)
+			|| Z_EVENT_BEVENT_OBJ_P(&bev->underlying)->bevent)) {
+		/* At Zend shutdown the underlying owner may already have retired its SSL. */
+		SSL_set_shutdown(ssl, SSL_RECEIVED_SHUTDOWN);
+		SSL_shutdown(ssl);
+	}
+#endif
+	bufferevent_free(bevent);
+#ifdef HAVE_EVENT_OPENSSL_LIB
+	/* CLOSE_ON_FREE transfers SSL ownership to libevent, including deferred free. */
+	if (ssl && bev->ssl_owned) {
+		SSL_free(ssl);
+	}
+	bev->ssl_owned = 0;
+#endif
