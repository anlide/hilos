+static HashTable * php_event_bevent_get_gc(zend_object *object, zval **gc_data, int *gc_count)/*{{{*/
+{
+	php_event_bevent_t *bev = Z_EVENT_X_FETCH_OBJ(bevent, object);
+	zend_get_gc_buffer *gc = zend_get_gc_buffer_create();
+
+	zend_get_gc_buffer_add_zval(gc, &bev->data);
+	zend_get_gc_buffer_add_zval(gc, &bev->base);
+	zend_get_gc_buffer_add_zval(gc, &bev->input);
+	zend_get_gc_buffer_add_zval(gc, &bev->output);
+	zend_get_gc_buffer_add_zval(gc, &bev->cb_read.func_name);
+	zend_get_gc_buffer_add_zval(gc, &bev->cb_write.func_name);
+	zend_get_gc_buffer_add_zval(gc, &bev->cb_event.func_name);
+#ifdef HAVE_EVENT_OPENSSL_LIB
+	zend_get_gc_buffer_add_zval(gc, &bev->ssl_context);
+	zend_get_gc_buffer_add_zval(gc, &bev->underlying);
+#endif
+	/* A live HTTP handle's counted self is a native root, not a PHP cycle.
+	 * Explicit free retires its callback argument before exposing that reference. */
+	if (bev->_internal && !bev->bevent) {
+		zend_get_gc_buffer_add_zval(gc, &bev->self);
+	}
+	zend_get_gc_buffer_use(gc, gc_data, gc_count);
+	return zend_std_get_properties(object);
+}/*}}}*/
 
