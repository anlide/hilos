+/* {{{ proto ?string EventBufferEvent::sslGetPeerCertificate(void);
+ * Returns the peer leaf certificate as PEM, without asserting its trust. */
+PHP_EVENT_METHOD(EventBufferEvent, sslGetPeerCertificate)
+{
+	php_event_bevent_t *bev;
+	SSL               *ssl;
+	X509              *certificate;
+	BIO               *bio;
+	char              *pem;
+	long               length;
+
+	if (zend_parse_parameters_none() == FAILURE) {
+		return;
+	}
+
+	bev = Z_EVENT_BEVENT_OBJ_P(getThis());
+	if (!bev->bevent) {
+		RETURN_NULL();
+	}
+
+	/* The bufferevent owns ssl; only the certificate reference is ours. */
+	ssl = bufferevent_openssl_get_ssl(bev->bevent);
+	if (!ssl) {
+		RETURN_NULL();
+	}
+	certificate = SSL_get_peer_certificate(ssl);
+	if (!certificate) {
+		RETURN_NULL();
+	}
+
+	bio = BIO_new(BIO_s_mem());
+	if (!bio) {
+		X509_free(certificate);
+		zend_throw_error(NULL, "Failed to allocate peer certificate BIO");
+		return;
+	}
+	if (PEM_write_bio_X509(bio, certificate) != 1) {
+		X509_free(certificate);
+		BIO_free(bio);
+		zend_throw_error(NULL, "Failed to encode peer certificate as PEM");
+		return;
+	}
+	X509_free(certificate);
+
+	length = BIO_get_mem_data(bio, &pem);
+	RETVAL_STRINGL(pem, length);
+	BIO_free(bio);
 }
 /* }}} */
 
