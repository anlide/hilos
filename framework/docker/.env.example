# Host-specific overrides for the framework stack — copy to docker/.env.
#
# Compose reads a `.env` from THIS directory (docker/) before any container
# exists and uses it to interpolate the ${VAR:-default} publishes in
# docker-compose.yml. docker/.env is gitignored (host-specific): leave it
# absent, or leave a knob below commented, and compose keeps the default shown —
# no setup step is needed on a fresh clone.

# Bind address for the framework stack's non-Ollama host publishes (the
# agent-host port and the framework test MySQL). The default 127.0.0.1 keeps a
# fresh clone closed. Set it ONLY on a host that must expose those to a LAN or
# tailnet. A bogus value fails at `up` with docker's own "bind: cannot assign
# requested address".
# HILOS_BIND_HOST=127.0.0.1

# Bind address for Ollama (the local LLM), kept separate because its consumer —
# the chat daemon — lives in ANOTHER compose project and reaches it across the
# bridge, not over loopback. The default 127.0.0.1 keeps a fresh clone closed.
# A host that serves the LLM to demo stacks sets this to 172.17.0.1 (the docker0
# gateway, reachable from any bridge network and stable across network
# re-creation) and points the chat demo's LLM_LOCAL_URL at the same address.
# HILOS_OLLAMA_BIND_HOST=127.0.0.1
