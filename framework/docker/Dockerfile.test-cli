# PHP CLI image for Composer + PHPUnit on the Hilos monorepo (Linux; matches platform reqs).
# Used only via docker compose — do not rely on host PHP version or OS.

FROM php:8.4-cli

# default-mysql-client provides the `mysql` binary the restore engine integration
# tests replay dumps through (BackupRestorer); the dumps themselves are hand-written
# fixtures, so mysqldump is not needed here.
#
# rsync and openssh-client are the shipping drivers' own binaries: the integration
# run really copies an archive to sshd-framework-test, which is only a proof if the
# runner ships with what a deployment would have to install.
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    zip \
    unzip \
    libonig-dev \
    default-mysql-client \
    rsync \
    openssh-client \
 && rm -rf /var/lib/apt/lists/*

# Align with root composer.json (ext-posix, pcntl, sockets, mbstring, mysqli, …)
RUN docker-php-ext-install -j$(nproc) \
    sockets \
    pcntl \
    posix \
    mbstring \
    mysqli \
    pdo \
    pdo_mysql

# ext-inotify is optional for the framework (composer suggest): the filesystem watch
# falls back to polling without it. The test image installs it so the suite exercises
# BOTH engines for real instead of only the fallback.
RUN pecl channel-update pecl.php.net \
 && yes "" | pecl install -o -f inotify \
 && rm -f /usr/local/etc/php/conf.d/docker-php-ext-inotify.ini \
 && echo "extension=inotify" > /usr/local/etc/php/conf.d/30-inotify.ini

COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

WORKDIR /hilos
