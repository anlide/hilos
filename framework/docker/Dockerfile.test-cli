# PHP CLI image for Composer + PHPUnit on the Hilos monorepo (Linux; matches platform reqs).
# Used only via docker compose — do not rely on host PHP version or OS.

FROM php:8.4-cli

# libevent-dev is what ext-event compiles against; libssl-dev answers the pecl
# prompt's default (event-openssl=yes), which otherwise stops the build looking
# for OpenSSL.
#
# default-mysql-client provides the `mysql` binary the restore engine integration
# tests replay dumps through (BackupRestorer); the dumps themselves are hand-written
# fixtures, so mysqldump is not needed here.
#
# rsync and openssh-client are the shipping drivers' own binaries: the integration
# run really copies an archive to sshd-framework-test, which is only a proof if the
# runner ships with what a deployment would have to install.
#
# age is the same kind of proof for the encrypted half: the integration run really
# encrypts the archive it ships and really decrypts it back, so the package has to be
# here and not mocked. It also carries age-keygen, which is what mints the throwaway
# key pair that round trip is run with.
RUN apt-get update && apt-get install -y --no-install-recommends \
    libevent-dev \
    libssl-dev \
    git \
    zip \
    unzip \
    libonig-dev \
    default-mysql-client \
    rsync \
    openssh-client \
    age \
 && rm -rf /var/lib/apt/lists/*

# Align with root composer.json (ext-posix, pcntl, sockets, mbstring, mysqli, …)
RUN docker-php-ext-install -j$(nproc) \
    sockets \
    pcntl \
    posix \
    mbstring \
    mysqli \
    pdo \
    pdo_mysql

# PHP reads conf.d alphabetically, so 30-event.ini would sort BEFORE the generated
# docker-php-ext-sockets.ini and event would load without sockets. Renumbering
# sockets to 20- puts the pair back in dependency order.
RUN rm -f /usr/local/etc/php/conf.d/docker-php-ext-sockets.ini \
 && echo "extension=sockets" > /usr/local/etc/php/conf.d/20-sockets.ini

# ext-event carries the epoll-based event loop the daemon runs on, and the root
# composer.json requires it: without it `composer install` refuses in this image.
RUN pecl channel-update pecl.php.net \
 && yes "" | pecl install -o -f event \
 && rm -f /usr/local/etc/php/conf.d/docker-php-ext-event.ini \
 && echo "extension=event" > /usr/local/etc/php/conf.d/30-event.ini

# ext-inotify is optional for the framework (composer suggest): the filesystem watch
# falls back to polling without it. The test image installs it so the suite exercises
# BOTH engines for real instead of only the fallback.
RUN yes "" | pecl install -o -f inotify \
 && rm -f /usr/local/etc/php/conf.d/docker-php-ext-inotify.ini \
 && echo "extension=inotify" > /usr/local/etc/php/conf.d/30-inotify.ini

COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

WORKDIR /hilos
