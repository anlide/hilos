# Reverse proxy for the in-tailnet Hilos preview lane.
#
# Serves the demos under readable *.hilos names on the host's Tailscale IP and
# hides their per-demo ports. Certificates come from Caddy's own internal CA
# (the names are private, so public ACME can't validate them) — install the CA
# root on client devices once to get a green padlock. See the preview docs.
#
# Binds only the Tailscale IP so it never clashes with the hleb.studio proxy on
# the public IP. Override HILOS_PREVIEW_BIND for a different host.
{
	default_bind {$HILOS_PREVIEW_BIND:100.111.250.126}
}

# Shared per-demo settings: private cert from the internal CA.
(demo) {
	tls internal
}

# Plain-HTTP endpoint to download the internal CA root, so devices can trust the
# *.hilos certs. Open http://ca.hilos/nova-lt.crt on each device and install it.
# Serves ONLY the public root cert — never the CA private keys that sit in the
# same directory (no directory listing, everything else gets a plain message).
http://ca.hilos {
	@cert path /nova-lt.crt /root.crt
	handle @cert {
		root * /data/caddy/pki/authorities/local
		rewrite * /root.crt
		file_server
	}
	handle {
		respond "Hilos preview CA — download the root at /nova-lt.crt" 200
	}
}

# --- chat ---
chat.hilos {
	import demo
	reverse_proxy 127.0.0.1:5173
}

# Daemon WebSocket over TLS: the app runs on https://chat.hilos, so its socket
# must be wss (a plain ws:// would be blocked as mixed content). VITE_WS_URL points
# the browser here.
ws.chat.hilos {
	import demo
	reverse_proxy 127.0.0.1:8092
}

pma.chat.hilos {
	import demo
	reverse_proxy 127.0.0.1:8080
}

status.chat.hilos {
	import demo
	reverse_proxy 127.0.0.1:8090
}

# --- simple-todo ---
todo.hilos {
	import demo
	reverse_proxy 127.0.0.1:5174
}

# Daemon WebSocket over TLS (see the chat note above). VITE_WS_URL points here.
ws.todo.hilos {
	import demo
	reverse_proxy 127.0.0.1:8100
}

pma.todo.hilos {
	import demo
	reverse_proxy 127.0.0.1:8081
}

status.todo.hilos {
	import demo
	reverse_proxy 127.0.0.1:8098
}

# --- simple-poll ---
# Angular serves the app and proxies its own same-origin /ws to the daemon, so a
# single route carries both the page and the WebSocket — no ws.poll.hilos needed.
poll.hilos {
	import demo
	reverse_proxy 127.0.0.1:5175
}

pma.poll.hilos {
	import demo
	reverse_proxy 127.0.0.1:8082
}

status.poll.hilos {
	import demo
	reverse_proxy 127.0.0.1:8104
}

# --- landing page ---
# One place that lists every demo and links the CA-install page. Served from the
# static site mounted into the caddy container (docker-compose.caddy.yml).
home.hilos {
	import demo
	root * /srv/preview
	file_server
}
