# Environment configuration
.env

# Vendor
vendor/

# Node
node_modules/

# IDE
.vscode/
.idea/
.cursor/
!.cursor/
.cursor/*
!.cursor/rules/
.cursor/rules/*
!.cursor/rules/hilos-framework.mdc

# OS
.DS_Store
Thumbs.db

# Editor
*.swp
*.swo
*.sw?
*.suo
*.ntvs*
*.njsproj
*.sln

# AI agents — artifacts materialized by `composer ai:install`
# (canonical sources stay tracked: agents.md, docs/agents/, skills/hilos-*)
.codex
/.agents/
/AGENTS.md
/GEMINI.md
/.aider.conf.yml

# Claude Code (personal/local settings only; shared .claude config stays tracked)
/.claude/settings.local.json
# Skills copied from skills/ by `composer ai:install` (tracked at their real path)
/.claude/skills
# Git worktrees created by Claude Code sessions
/.claude/worktrees

# Test-suite runner output: per-step logs and the rc ledger of a full run
/var/

# Protected-mode freeze left beside the daemon log (HIL-482): a node writes it while
# it is frozen and removes it when the freeze lifts, so only a run interrupted mid-freeze
# leaves one in a demo's data/logs. Ignored by name rather than per demo — nothing in the
# repository is ever meant to carry this file.
protected-mode.state.json
protected-mode.state.json.tmp
